FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
# Debian snapshot indexes are signed; package hashes are checked by apt.
# Keep the timestamp immutable and refresh only in a reviewed dependency change.
RUN node -e "require('fs').writeFileSync('/tmp/peace-bootstrap-ca.pem',require('tls').rootCertificates.join('\n'))" \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261023T000000Z bookworm main' 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261023T000000Z bookworm-security main' > /etc/apt/sources.list \
 && apt-get -o Acquire::https::CaInfo=/tmp/peace-bootstrap-ca.pem -o APT::Update::Error-Mode=any update \
 && apt-get -o Acquire::https::CaInfo=/tmp/peace-bootstrap-ca.pem install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* /tmp/peace-bootstrap-ca.pem
WORKDIR /app/SpaceX/Server
COPY ["SpaceX/Server/package.json", "SpaceX/Server/package-lock.json", "./"]
# better-sqlite3 13 ships N-API prebuilds for linux-x64/arm64; no
# runtime compiler or install-time GitHub binary download is needed.
# Avoid npm auto-detecting binding.gyp on a clean lockfile install. All pinned
# runtime dependencies are script-free; the SQL smoke check loads the real addon.
RUN npm ci --include=dev --ignore-scripts && node -e "const D=require('better-sqlite3');const d=new D(':memory:');d.prepare('SELECT 1').get();d.close();"
COPY ["SpaceX/Server/", "/app/SpaceX/Server/"]
COPY ["SpaceX/Desktop/", "/app/SpaceX/Desktop/"]
COPY ["tools/", "/app/tools/"]
COPY ["README.txt", "/app/README.txt"]
RUN node /app/tools/package-check/verify-package.js && node tests/runtime/spacex.test-railway-process-lifecycle.js && node tests/storage/spacex.test-retired-support-storage.js && node tests/web/spacex.test-retired-support-http.js && node tests/network/spacex.test-connect-tls-flush.js && node tests/fixtures/integrity/spacex.test-native-receive-fixture.js && node tests/overlay/spacex.test-overlay-imgui.js && node --test tests/integrity/spacex.test-pointer-general-probe.js tests/protocol/spacex.test-native-policy-contract-vectors.js tests/source/spacex.test-native-startup-observations.js tests/source/spacex.test-device-security-owned.js tests/security/spacex.test-server-operation-transcript-validation.js tests/network/spacex.test-tls-transport-boundaries.js tests/integrity/spacex.test-owned-runtime-measurement.js tests/observability/spacex.test-lifecycle-event-contract.js tests/observability/spacex.test-lifecycle-trace.js tests/network/spacex.test-server-profile-contract.js tests/cryptography/spacex.test-crc-collision-vectors.js tests/security/spacex.test-server-authority-bypass.js tests/bootstrap/spacex.test-keyless-bootstrap.js tests/bootstrap/spacex.test-keyless-legacy-receipts.js tests/bootstrap/spacex.test-repeat-approval-legacy.js tests/security/spacex.test-server-policy-registry.js tests/runtime/spacex.test-server-policy-worker.js tests/runtime/spacex.test-worker-result-ownership.js tests/security/spacex.test-server-policy-operations.js tests/integrity/spacex.test-owned-pointer-graph.js tests/integrity/spacex.test-authority-measurement-security.js tests/overlay/spacex.test-cohort-retirement.js tests/bootstrap/spacex.test-issued-a-signing.js tests/integrity/spacex.test-pointer-graph-lifecycle.js tests/licensing/spacex.test-desktop-members.js tests/protocol/spacex.test-document-schema.js && node --test tests/security/spacex.test-release-readiness.js tests/security/spacex.test-server-operation-arguments.js && node --test tests/security/spacex.test-release-audit-runner.js tests/security/spacex.test-release-audit-file-races.js tests/security/spacex.test-release-readiness-route-lifetime.js tests/security/spacex.test-server-operation-results.js tests/source/spacex.test-sensitive-copy-lifetime.js && node --test tests/bootstrap/spacex.test-issued-a-keyring.js tests/bootstrap/spacex.test-issued-a-trust-inspector.js tests/bootstrap/spacex.test-keyless-tpm-recovery.js tests/source/spacex.test-native-string-contract-reader.js tests/overlay/spacex.test-overlay-transfer.js && node tests/security/spacex.test-release-readiness-http.js && node --test tests/integrity/spacex.test-desktop-integrity-reports.js tests/web/spacex.test-owned-runtime-graph-ui.js && node --test tests/web/spacex.test-workspace-shell.js tests/web/spacex.test-operational-workspace-ui.js tests/web/spacex.test-desktop-member-ui.js tests/web/spacex.test-desktop-admin-ui.js tests/web/spacex.test-admin-modal-isolation.js tests/web/spacex.test-registration-reset-ui.js && node tests/overlay/spacex.test-overlay-download-lifetime.js && node --test tests/overlay/spacex.test-overlay-parent-startup-lease.js tests/overlay/spacex.test-overlay-startup-failure.js && node tests/runtime/spacex.test-web-full-reset.js && node --test tests/licensing/spacex.test-license-products.js tests/overlay/spacex.test-overlay-products.js && node tests/web/spacex.check-web-ui.js
# Validate the UI with pinned test dependencies, then retain production dependencies only.
RUN npm prune --omit=dev --ignore-scripts && node -e "const D=require('better-sqlite3');const d=new D(':memory:');d.prepare('SELECT 1').get();d.close();"
ENV NODE_ENV=production
CMD ["node", "spacex.relay-server.js"]
