# Relay-only Railway build. The separate full Cozy/NHW ZIP is the native source of truth.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app/cozy-peace/Relay\ Server
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts && node -e "const D=require('better-sqlite3'); const db=new D(':memory:'); db.prepare('SELECT 1').get(); db.close();"
COPY . ./
# Validate the shipped web bundle, browser cache contract and modal controllers
# before accepting an NHW/server change as a production-ready deployment.
RUN node tests/web/peace.check-web-ui.js \
 && node tests/web/peace.test-web-ui-cache.js \
 && node tests/web/peace.test-admin-modal-isolation.js \
 && node tests/web/peace.test-server-state-ui.js \
 && node tests/web/peace.test-server-state-service-ui.js \
 && node tests/web/peace.test-desktop-member-ui.js \
 && node --test tests/security/peace.test-nhw-signal-origin.js \
 && node --test tests/security/peace.test-nhw-v5-typed-output.js \
 && node tests/security/peace.test-nhw-context-policy.js \
 && node tests/security/peace.test-nhw-peer-context.js
RUN npm prune --omit=dev --ignore-scripts
ENV NODE_ENV=production
CMD ["node","peace.relay-server.js"]
