ICAgXQogIH0KfQo=
'@
    $bytes = [Convert]::FromBase64String($contractBase64)
    Assert-Condition ($bytes.Length -gt 0 -and $bytes.Length -le 1048576)
    $hasher = [Security.Cryptography.SHA512]::Create()
    try { $digest = ([BitConverter]::ToString($hasher.ComputeHash($bytes))).Replace('-', '').ToLowerInvariant() }
    finally { $hasher.Dispose() }
    Assert-Condition ($digest -ceq '7c7c0b91ca03dbbb32f0bb79297a0a9489b7e1b7ab6351c5e2682accbf2714699dcf5d58bc4eb3152992352a2cd46ac0655d6638ffca8ab0c89f9adeb541ba3d')
    $utf8 = New-Object Text.UTF8Encoding($false, $true)
    $manifest = $utf8.GetString($bytes) | ConvertFrom-Json
    Assert-Properties $manifest @('schema', 'purpose', 'roles')
    Assert-Condition ($manifest.schema -eq 2 -and $manifest.purpose -ceq 'source and runtime API target contract; not process attestation')
    $roles = @('gcrLauncher', 'gcrConnect', 'gcrOverlay')
    $labels = @('A', 'B', 'O')
    $totalCounts = @(219, 270, 265)
    $optionalCounts = @(9, 9, 11)
    $allowedModules = @('advapi32.dll', 'bcrypt.dll', 'crypt32.dll', 'd3d11.dll', 'd3dcompiler_47.dll', 'dcomp.dll', 'iphlpapi.dll', 'kernel32.dll', 'ncrypt.dll', 'ntdll.dll', 'ole32.dll', 'psapi.dll', 'secur32.dll', 'tbs.dll', 'ucrtbase.dll', 'user32.dll', 'ws2_32.dll', 'wtsapi32.dll')
    Assert-Properties $manifest.roles $roles
    for ($roleIndex = 0; $roleIndex -lt $roles.Length; $roleIndex++) {
        $entries = $manifest.roles.($roles[$roleIndex])
        Assert-Condition ($entries -is [Array] -and $entries.Length -eq $totalCounts[$roleIndex])
        $seenSlots = @{}
        $optional = 0
        foreach ($entry in $entries) {
            Assert-Properties $entry @('unit', 'slot', 'module', 'hash', 'lookup', 'procName', 'optional', 'api', 'callingConvention', 'ownershipContract')
            Assert-Condition ($entry.unit -is [string] -and $entry.unit -cmatch '\ACozy\.[A-Za-z0-9_.]{1,80}\z')
            Assert-Condition ($entry.slot -is [string] -and $entry.slot -cmatch '\A[A-Za-z_][A-Za-z0-9_]{0,100}(?:\[[0-9]{1,3}\])?\z')
            Assert-Condition ($entry.module -is [string] -and $allowedModules -ccontains $entry.module)
            Assert-Condition ($entry.api -is [string] -and $entry.api -cmatch '\A[A-Za-z_][A-Za-z0-9_]{0,127}\z')
            Assert-Condition ($entry.optional -is [bool])
            Assert-Condition (($entry.hash -is [int] -or $entry.hash -is [long]) -and $entry.hash -ge 0 -and $entry.hash -le 4294967295)
            Assert-Condition ($entry.lookup -is [string] -and @('hash', 'name') -ccontains $entry.lookup)
            Assert-Condition ($entry.procName -is [string])
            if ($entry.lookup -ceq 'hash') {
                Assert-Condition ($entry.procName -ceq '' -and [uint64]$entry.hash -eq (Get-PublicApiHash $entry.api))
            }
            else {
                # Production clock bootstrap uses these reviewed named exports.
                # A zero hash is valid only for this exact, mandatory name contract.
                $clockNames = @('QueryPerformanceCounter', 'QueryPerformanceFrequency', 'CreateEventW', 'WaitForSingleObject', 'CloseHandle', 'GetLastError', 'SetLastError')
                Assert-Condition ($entry.module -ceq 'kernel32.dll' -and $entry.hash -eq 0 -and -not $entry.optional)
                Assert-Condition ($entry.procName -ceq $entry.api -and $clockNames -ccontains $entry.procName)
                Assert-Condition ($entry.unit -ceq 'Cozy.Clock' -and $entry.slot -ceq ('ClockSlot_' + $entry.procName))
            }
            Assert-Condition ($entry.callingConvention -is [string] -and $entry.callingConvention.Length -ge 1 -and $entry.callingConvention.Length -le 200 -and $entry.callingConvention -notmatch '[\x00-\x1f\x7f]')
            Assert-Condition ($entry.ownershipContract -is [string] -and $entry.ownershipContract.Length -ge 1 -and $entry.ownershipContract.Length -le 300 -and $entry.ownershipContract -notmatch '[\x00-\x1f\x7f]')
            $slotKey = $entry.unit + ':' + $entry.slot
            Assert-Condition (-not $seenSlots.ContainsKey($slotKey))
            $seenSlots[$slotKey] = $true
            if ($entry.optional) { $optional++ }
        }
        Assert-Condition ($optional -eq $optionalCounts[$roleIndex])
    }

    $native = New-SystemLoader $systemDirectory
    $load = $native.GetMethod('LoadLibraryExW')
    $resolve = $native.GetMethod('GetProcAddress')
    $release = $native.GetMethod('FreeLibrary')
    $systemInfo = [Runtime.InteropServices.Marshal]::AllocHGlobal(64)
    try {
        $null = $native.GetMethod('GetNativeSystemInfo').Invoke($null, [object[]]@($systemInfo))
        # PROCESSOR_ARCHITECTURE_AMD64 = 9. Do not trust an environment variable.
        Assert-Condition ([Runtime.InteropServices.Marshal]::ReadInt16($systemInfo) -eq 9)
    }
    finally { [Runtime.InteropServices.Marshal]::FreeHGlobal($systemInfo) }

    $handles = @{}
    $references = New-Object 'Collections.Generic.List[IntPtr]'
    $available = @{}
    $results = New-Object 'Collections.Generic.List[object]'
    $cleanupFailed = $false
    try {
        foreach ($moduleName in $allowedModules) {
            $modulePath = [IO.Path]::Combine($systemDirectory, $moduleName)
            Assert-Condition ([IO.Path]::GetDirectoryName($modulePath) -ceq $systemDirectory)
            # Absolute System32 path plus LOAD_LIBRARY_SEARCH_SYSTEM32 only.
            $handle = [IntPtr]$load.Invoke($null, [object[]]@($modulePath, [IntPtr]::Zero, [uint32]0x800))
            $handles[$moduleName] = $handle
            if ($handle -ne [IntPtr]::Zero) { $references.Add($handle) }
        }
        for ($roleIndex = 0; $roleIndex -lt $roles.Length; $roleIndex++) {
            $entries = $manifest.roles.($roles[$roleIndex])
            $missingModules = New-Object 'Collections.Generic.List[string]'
            $missingRequired = New-Object 'Collections.Generic.List[string]'
            $missingOptional = New-Object 'Collections.Generic.List[string]'
            $count = 0
            foreach ($entry in $entries) {
                $moduleName = [string]$entry.module
                $identity = $moduleName + '!' + $entry.api
                if ($handles[$moduleName] -eq [IntPtr]::Zero) {
                    if (-not $missingModules.Contains($moduleName)) { $missingModules.Add($moduleName) }
                    continue
                }
                if (-not $available.ContainsKey($identity)) {
                    $address = [IntPtr]$resolve.Invoke($null, [object[]]@($handles[$moduleName], [string]$entry.api))
                    $available[$identity] = ($address -ne [IntPtr]::Zero)
                }
                if ($available[$identity]) {
                    # Preserve each separate source slot even for the same API.
                    $count++
                }
                elseif ($entry.optional) { $missingOptional.Add($identity) }
                else { $missingRequired.Add($identity) }
            }
            $unsupportedPair = $false
            if ($roles[$roleIndex] -ceq 'gcrOverlay' -and $handles['wtsapi32.dll'] -ne [IntPtr]::Zero) {
                $one = $available['wtsapi32.dll!WTSRegisterSessionNotification']
                $two = $available['wtsapi32.dll!WTSUnRegisterSessionNotification']
                # Renderer binds this pair together; asymmetric presence fails startup.
                $unsupportedPair = ($one -ne $two)
            }
            $results.Add([pscustomobject]@{
                Label = $labels[$roleIndex]
                Count = $count
                SourceTotal = $totalCounts[$roleIndex]
                RequiredTotal = $totalCounts[$roleIndex] - $optionalCounts[$roleIndex]
                MissingModules = @($missingModules.ToArray())
                MissingRequired = @($missingRequired.ToArray())
                MissingOptional = @($missingOptional.ToArray())
                UnsupportedPair = $unsupportedPair
            })
        }
    }
    finally {
        for ($index = $references.Count - 1; $index -ge 0; $index--) {
            try {
                if ([int]$release.Invoke($null, [object[]]@($references[$index])) -eq 0) { $cleanupFailed = $true }
            }
            catch { $cleanupFailed = $true }
        }
    }
    Assert-Condition (-not $cleanupFailed)

    Write-Host 'Cozy Peace B 라이선스 ImGui + O 카드 UI 소스와 현재 Windows의 API 슬롯 예상값입니다.'
    Write-Host 'A/B/O 실행 파일을 실행하거나 검사한 결과가 아닙니다. 서버 설정은 변경하지 않았습니다.'
    Write-Host '해당 소스로 빌드한 동일 최종 후보인지 확인한 후에만 사용하세요.'
    Write-Host '이전 BAT의 수량을 재사용하지 말고, 아래 역할별 결과를 확인하세요.'
    Write-Host ''
    $exitStatus = 0
    foreach ($result in $results) {
        Write-Host ($result.Label + ': 소스 슬롯 최대 ' + $result.SourceTotal + '개 / 필수 ' + $result.RequiredTotal + '개 / 선택 ' + ($result.SourceTotal - $result.RequiredTotal) + '개')
        if ($result.MissingModules.Length -or $result.MissingRequired.Length -or $result.UnsupportedPair) {
            Write-Host ($result.Label + ': 사용 가능한 검사 규격 수량을 결정하지 못했습니다.')
            if ($result.MissingModules.Length) { Write-Host ('  System32 DLL 불러오기 실패: ' + ($result.MissingModules -join ', ')) }
            if ($result.MissingRequired.Length) { Write-Host ('  필수 API 없음: ' + ($result.MissingRequired -join ', ')) }
            if ($result.UnsupportedPair) { Write-Host '  선택 API 쌍의 지원 상태가 달라 이 환경의 시작 조건을 충족하지 못합니다.' }
            $exitStatus = 2
            continue
        }
        Write-Host ($result.Label + ': 이 Windows의 사용 가능 예상 슬롯 ' + $result.Count + '개 / 최소 = 최대 = ' + $result.Count)
        if ($result.MissingOptional.Length) { Write-Host ('  제외된 선택 API: ' + ($result.MissingOptional -join ', ')) }
    }
    Write-Host ''
    Write-Host '웹: 회원 · 프로그램 > 보안 · 검사 설정 > 서버 보안 · 배포 운영 > 빌드별 검사 규격 · 단계적 적용'
    Write-Host '검사 규격 대상에서 현재 운영 중인 최종 A/B/O 템플릿 후보를 각각 선택하세요.'
    Write-Host '각 후보에 해당하는 최소/최대 수량을 같게 입력하고 [이 빌드 규격 저장]을 누르세요.'
    Write-Host '이미 거부된 세션은 복구되지 않습니다. 저장 후 새 A를 발급하고 실행 중 기기 연결을 승인하세요.'
}
catch {
    Write-Host '검사를 완료하지 못했습니다. Windows x64의 Windows PowerShell 5.1과 이 BAT 원본 파일을 확인하세요.'
    Write-Host '등록에 사용할 수량을 추정하지 마세요. 세부 예외나 개인 경로는 출력하지 않습니다.'
    $exitStatus = 1
}
exit $exitStatus
