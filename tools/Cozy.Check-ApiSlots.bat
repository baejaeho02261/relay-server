#requires -Version 5.1
[CmdletBinding()]
param()

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$exitStatus = 1

function Assert-Condition([bool]$Value) {
    if (-not $Value) { throw 'COZY_API_EXPECTATION_INVALID' }
}

function Assert-Properties($Value, [string[]]$Names) {
    Assert-Condition ($null -ne $Value -and $Value -is [pscustomobject])
    $actual = @($Value.PSObject.Properties.Name | Sort-Object -CaseSensitive)
    $expected = @($Names | Sort-Object -CaseSensitive)
    Assert-Condition (($actual -join '|') -ceq ($expected -join '|'))
}

function Get-PublicApiHash([string]$Name) {
    [uint64]$value = 0
    [uint64]$mask = 4294967295
    foreach ($b in [Text.Encoding]::ASCII.GetBytes($Name)) {
        $value = (((($value -shr 13) -bor (($value -shl 19) -band $mask)) + [uint64]$b) -band $mask)
    }
    return $value
}

function New-SystemLoader([string]$SystemDirectory) {
    # In-memory P/Invoke metadata only: no Add-Type/C# compiler or temporary DLL.
    $name = New-Object Reflection.AssemblyName('CozyOperatorApiSlotCheck')
    $assembly = [AppDomain]::CurrentDomain.DefineDynamicAssembly($name, [Reflection.Emit.AssemblyBuilderAccess]::Run)
    $module = $assembly.DefineDynamicModule('CozyOperatorApiSlotCheck')
    $attributes = [Reflection.TypeAttributes]::Public -bor [Reflection.TypeAttributes]::Abstract -bor [Reflection.TypeAttributes]::Sealed
    $type = $module.DefineType('CozyOperatorSystemLoader', $attributes)
    $methodAttributes = [Reflection.MethodAttributes]::Public -bor [Reflection.MethodAttributes]::Static -bor [Reflection.MethodAttributes]::PinvokeImpl
    $kernel = [IO.Path]::Combine($SystemDirectory, 'kernel32.dll')
    $definitions = @(
        @{ Name = 'LoadLibraryExW'; Return = [IntPtr]; Parameters = [Type[]]@([string], [IntPtr], [uint32]); Charset = [Runtime.InteropServices.CharSet]::Unicode },
        @{ Name = 'GetProcAddress'; Return = [IntPtr]; Parameters = [Type[]]@([IntPtr], [string]); Charset = [Runtime.InteropServices.CharSet]::Ansi },
        @{ Name = 'FreeLibrary'; Return = [int]; Parameters = [Type[]]@([IntPtr]); Charset = [Runtime.InteropServices.CharSet]::Ansi },
        @{ Name = 'GetNativeSystemInfo'; Return = [void]; Parameters = [Type[]]@([IntPtr]); Charset = [Runtime.InteropServices.CharSet]::Ansi }
    )
    foreach ($definition in $definitions) {
        $method = $type.DefinePInvokeMethod($definition.Name, $kernel, $definition.Name,
            $methodAttributes, [Reflection.CallingConventions]::Standard,
            $definition.Return, $definition.Parameters,
            [Runtime.InteropServices.CallingConvention]::Winapi, $definition.Charset)
        $method.SetImplementationFlags([Reflection.MethodImplAttributes]::PreserveSig)
    }
    return $type.CreateType()
}

