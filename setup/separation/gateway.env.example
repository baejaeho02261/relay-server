# Network values are deliberately blank. Set the actual values in the deployment environment.
# PRIVATE server-side deployment input. No ADMIN_SECRET/DATA_DIR/signing keys here.
GATEWAY_PUBLIC_ORIGIN=
GATEWAY_UPSTREAM=https://authority.private.example:8443
GATEWAY_AUTHORITY_SPKI_SHA512=REPLACE_WITH_128_LOWERCASE_HEX
# For Railway ingress only: use GATEWAY_MODE=railway, GATEWAY_EDGE_ONLY=1 and
# PORT=8080 in the service environment, with platform RAILWAY_* context.
# Do not combine this direct-TLS compose port with Railway HTTP target blindly.
