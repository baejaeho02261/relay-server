# Configure real values on the server. Do not commit secrets.
ADMIN_SECRET=
PORT=8080
CONNECT_TCP_PORT=3000
WEB_ADMIN_PORT=8080
DATA_DIR=/data
STORAGE_ENGINE=sqlite
HA_ENABLED=0
# Optional on Railway: leave BOTH empty to use its TCP Proxy variables.
DESKTOP_PUBLIC_HOST=
DESKTOP_PUBLIC_PORT=
# Legacy endpoint/profile proxy switch; NOT an administrator HTTPS trust switch:
DESKTOP_TRUST_PROXY=0

# TLS is mandatory for the native TCP listener. The supplied Dockerfile includes
# OpenSSL and generates one private server identity in persistent DATA_DIR.
# Retain DATA_DIR across deployments; never bundle its keys into client files.
CONNECT_TLS_SERVER_NAME=game-connect.internal
# Optional: provide BOTH paths instead of automatic persistent generation.
# Certificate must contain the exact DNS SAN above and match its RSA private key.
CONNECT_TLS_CERT_FILE=
CONNECT_TLS_KEY_FILE=

# Administrator security 1-3. These variables must be loaded into the service
# environment; this example file is NOT automatically loaded by Node.js.
# "proxy": HTTPS proxy in the SAME host/network namespace; plain origin is loopback.
# "direct": native HTTPS with your trusted certificate/key; see the delivery guide.
WEB_ADMIN_TRANSPORT=proxy
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_TRUSTED_PROXIES=127.0.0.1/32,::1/128
WEB_ADMIN_REQUIRE_HTTPS=1
WEB_ADMIN_SECURE_COOKIE=1
# Set the exact real admin domain. No Host-header fallback, no parent-domain RP.
# Example: WEBAUTHN_RP_ID=admin.example.com
#          WEBAUTHN_ORIGIN=https://admin.example.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Direct mode only: set WEB_ADMIN_TRUSTED_PROXIES= (empty), a bind IP and BOTH files.
WEB_ADMIN_TLS_CERT_FILE=
WEB_ADMIN_TLS_KEY_FILE=

# Security 4-6: unset uses the built-in push-service allowlist.
# Optional exact FQDN list REPLACES defaults; no URL, wildcard or private-IP bypass.
# WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
# Push connects directly over TLS 443 to a checked DNS address; no outbound proxy fallback.
