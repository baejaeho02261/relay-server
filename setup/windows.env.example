# Configure real values on the server. Do not commit secrets.
ADMIN_SECRET=
PORT=8080
CONNECT_TCP_PORT=3000
WEB_ADMIN_PORT=8080
DATA_DIR=/data
STORAGE_ENGINE=sqlite
HA_ENABLED=0
# Optional on Railway: leave BOTH empty to use its TCP Proxy variables.
DESKTOP_PUBLIC_HOST=
DESKTOP_PUBLIC_PORT=
# Administrator HTTP proxy trust uses exact IPs, never the client-supplied headers.
# Empty = forwarded IP/protocol headers are ignored.
WEB_ADMIN_TRUSTED_PROXY_IPS=
WEB_ADMIN_SESSION_MS=1800000
WEB_ADMIN_ABSOLUTE_SESSION_MS=43200000
WEB_ADMIN_LOGIN_MAX_ATTEMPTS=10
WEB_ADMIN_LOGIN_WINDOW_MS=900000

# TLS is mandatory for the native TCP listener. The supplied Dockerfile includes
# OpenSSL and generates one private server identity in persistent DATA_DIR.
# Retain DATA_DIR across deployments; never bundle its keys into client files.
CONNECT_TLS_SERVER_NAME=game-connect.internal
# Optional: provide BOTH paths instead of automatic persistent generation.
# Certificate must contain the exact DNS SAN above and match its RSA private key.
CONNECT_TLS_CERT_FILE=
CONNECT_TLS_KEY_FILE=
