# Server-side only. Keep actual secrets outside source and APK.
MEMBER_OAUTH_PUBLIC_URL=https://relay-server-production-5386.up.railway.app
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
# Required: random 32-byte AES-256-GCM encryption key, 64 hexadecimal characters.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the SAME key on active/standby nodes and retain it with protected backups.
MEMBER_OAUTH_TOKEN_KEY=
# Optional Kakao external-unlink webhook (both required to enable its endpoint).
# Use the PRIMARY admin key, not a REST API key. Do not put it in the APK.
KAKAO_APP_ID=
KAKAO_UNLINK_ADMIN_KEY=
# Grant checks: default 30000ms, clamped to 30000..900000; worker wakes each 5s.
MEMBER_OAUTH_CHECK_INTERVAL_MS=30000
# Production biometric bypass is disabled regardless of this value.
MEMBER_BIOMETRIC_TEST_MODE=0
