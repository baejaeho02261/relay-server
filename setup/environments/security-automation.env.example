# Network values are deliberately blank. Set the actual values in the deployment environment.
# Optional server settings; defaults below. No client secrets or new package dependencies.
# Run deterministic parser mutations in isolated Node child processes at this interval.
# 0 = off; allowed interval 3600000..604800000 ms. Manual/CI tests still available.
GAME_PARSER_FUZZ_INTERVAL_MS=0
# New high-cost jobs only. Existing native renewal/close/cancel is not in this controller.
GAME_BACKGROUND_CONCURRENCY=2
GAME_BACKGROUND_RESERVED_MIB=1024
GAME_BACKGROUND_DISK_RESERVE_MIB=256
# 0 = derive 85% of detected cgroup memory, otherwise RSS gate unavailable.
GAME_BACKGROUND_MAX_RSS_MIB=0
# V8 heap limits are NOT limits for all native Buffer / external allocations.
# Configure real CPU / memory / pids / temporary filesystem quotas on the host.
# Existing setup/separation/*.compose.yml examples are NOT automatically deployed.
