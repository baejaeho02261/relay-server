# Network values are deliberately blank. Set the actual values in the deployment environment.
# Main Relay Server server ONLY. Optional: leave all DESKTOP_PACKER_* unset to disable packing.
# Replace placeholders; never use these literal examples as live keys/hostnames.
DESKTOP_PACKER_URL=
DESKTOP_PACKER_CA_FILE=/run/secrets/packer-ca.pem
DESKTOP_PACKER_CERT_FILE=/run/secrets/packer-client-cert.pem
DESKTOP_PACKER_KEY_FILE=/run/secrets/packer-client-key.pem
DESKTOP_PACKER_SPKI_SHA512=<128 lowercase hex digits of worker certificate SPKI DER SHA-512>
DESKTOP_PACKER_TOOL_SHA512=<128 lowercase hex digits of approved VMProtect CLI>
DESKTOP_PACKER_PROFILE_A_SHA512=<128 lowercase hex digits of reviewed A.vmp>
DESKTOP_PACKER_INPUT_A_SHA512=<128 lowercase hex digits of exact reviewed input A.exe>
DESKTOP_PACKER_PROFILE_B_SHA512=<128 lowercase hex digits of reviewed B.vmp>
DESKTOP_PACKER_INPUT_B_SHA512=<128 lowercase hex digits of exact reviewed input B.exe>
DESKTOP_PACKER_PROFILE_O_SHA512=<128 lowercase hex digits of reviewed O.vmp>
DESKTOP_PACKER_INPUT_O_SHA512=<128 lowercase hex digits of exact reviewed input O.exe>
