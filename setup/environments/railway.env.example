# Network values are deliberately blank. Set the actual values in the deployment environment.
# Railway managed-edge deployment example; this file is NOT loaded automatically.
# Apply only after verifying no raw TCP proxy targets the HTTP port and every
# service that can reach this listener privately is trusted/isolated.
# WEB_ADMIN_RAILWAY_EDGE_ONLY=1 is operator acknowledgement, NOT a firewall.
WEB_ADMIN_TRANSPORT=railway
WEB_ADMIN_RAILWAY_EDGE_ONLY=1
WEB_ADMIN_HOST=
WEB_ADMIN_REQUIRE_HTTPS=1
WEB_ADMIN_SECURE_COOKIE=1
WEB_ADMIN_TRUSTED_PROXIES=
# Example only: choose an HTTP port different from your EXISTING native TLS port.
# Railway public DOMAIN target port must match PORT/WEB_ADMIN_PORT.
PORT=
WEB_ADMIN_PORT=
# Preserve the EXISTING native target value, not the external Railway proxy port.
CONNECT_TCP_PORT=
# Keep the EXISTING passkey domain; do not change it merely to resolve HTTP 502.
# This must be the HTTPS administrator hostname actually used by the browser.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Railway supplies RAILWAY_PROJECT_ID / ENVIRONMENT_ID / SERVICE_ID.
# Do not invent these values or use them as credentials.
# Preserve DATA_DIR, existing volume, ADMIN_SECRET, all key/cert and TLS settings.
# Use /readyz as Railway HTTP healthcheck path; no separate HEALTH_PORT required.

CONNECT_TCP_HOST=
