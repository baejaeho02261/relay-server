# Network values are deliberately blank. Set the actual values in the deployment environment.
# Separate restricted packing host ONLY. Do not put release/admin secrets here.
PACKER_HOST=
PACKER_PORT=
PACKER_TLS_CA_FILE=C:/Packing/ca.pem
PACKER_TLS_CERT_FILE=C:/Packing/server-cert.pem
PACKER_TLS_KEY_FILE=C:/Packing/server-key.pem
PACKER_CLIENT_SPKI_SHA512=<128 lowercase hex digits of main server client certificate SPKI DER SHA-512>
PACKER_TOOL_FILE=C:/Packing/Trusted/VMProtect_Con.exe
PACKER_TOOL_SHA512=<128 lowercase hex digits of that CLI file>
PACKER_PROFILE_A_FILE=C:/Packing/Reviewed/A.vmp
PACKER_PROFILE_A_SHA512=<128 lowercase hex digits of A.vmp>
PACKER_INPUT_A_SHA512=<128 lowercase hex digits of exact input A.exe>
PACKER_PROFILE_B_FILE=C:/Packing/Reviewed/B.vmp
PACKER_PROFILE_B_SHA512=<128 lowercase hex digits of B.vmp>
PACKER_INPUT_B_SHA512=<128 lowercase hex digits of exact input B.exe>
PACKER_PROFILE_O_FILE=C:/Packing/Reviewed/O.vmp
PACKER_PROFILE_O_SHA512=<128 lowercase hex digits of O.vmp>
PACKER_INPUT_O_SHA512=<128 lowercase hex digits of exact input O.exe>
