# Network values are deliberately blank. Set the actual values in the deployment environment.
# Separate packing host only. Keep the authority and signer keys off this host.
# The tool must support this host OS; this does not add a new execution packer.
PACKER_CLIENT_SPKI_SHA512=REPLACE_WITH_AUTHORITY_CLIENT_SPKI_128_HEX
PACKER_TOOL_FILE=/tool/REPLACE_WITH_REVIEWED_TOOL
PACKER_TOOL_SHA512=REPLACE_WITH_TOOL_SHA512
PACKER_PROFILE_A_FILE=/profiles/A.vmp
PACKER_PROFILE_A_SHA512=REPLACE_WITH_PROFILE_SHA512
PACKER_INPUT_A_SHA512=REPLACE_WITH_EXACT_INPUT_EXE_SHA512
PACKER_PROFILE_B_FILE=/profiles/B.vmp
PACKER_PROFILE_B_SHA512=REPLACE_WITH_PROFILE_SHA512
PACKER_INPUT_B_SHA512=REPLACE_WITH_EXACT_INPUT_EXE_SHA512
PACKER_PROFILE_O_FILE=/profiles/O.vmp
PACKER_PROFILE_O_SHA512=REPLACE_WITH_PROFILE_SHA512
PACKER_INPUT_O_SHA512=REPLACE_WITH_EXACT_INPUT_EXE_SHA512
