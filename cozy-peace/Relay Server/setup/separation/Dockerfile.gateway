# Optional gateway-only image. Build context: Relay Server.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
WORKDIR /app
COPY ["config/peace.runtime-environment.js", "./config/"]
COPY ["services/security/peace.service-isolation.js", "./services/security/"]
COPY ["services/network/peace.server-peer-tls.js", "./services/network/"]
COPY ["services/storage/peace.durable-file.js", "./services/storage/"]
COPY ["tools/web/peace.admin-gateway.js", "./tools/web/"]
RUN chmod -R a-w /app
USER 10002:10002
ENV NODE_ENV=production GAME_SERVICE_ROLE=gateway GAME_SERVICE_UID=10002 GAME_ISOLATION_REQUIRED=1
CMD ["node", "tools/web/peace.admin-gateway.js"]
