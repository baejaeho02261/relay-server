    <DCCReference Include="..\..\Cozy.Source\Cozy.Configuration\Cozy.Strings.TestsPlatform.pas" />
    <DCCReference Include="..\..\Cozy.Source\Cozy.Configuration\Cozy.Strings.TestsSecurity.pas" />
  </ItemGroup>
</Project>
