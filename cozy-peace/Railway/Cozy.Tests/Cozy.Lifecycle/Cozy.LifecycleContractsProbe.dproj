  </PropertyGroup>
  <PropertyGroup>
    <DCC_IncludePath>$(MSBuildProjectDirectory)\..\..\Cozy.Source\Cozy.Security.NHW;$(DCC_IncludePath)</DCC_IncludePath>
  </PropertyGroup>
