<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{6663BE92-CBF1-5A34-8597-BF0F74433496}</ProjectGuid>
    <ProjectVersion>21.0</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <MainSource>Cozy.NHW.FileGuard.Tests.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>2</TargetedPlatforms>
    <AppType>Console</AppType>
    <DCC_DcuOutput>.\dcu\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_ExeOutput>.</DCC_ExeOutput>
    <DCC_UnitSearchPath>.;..\..\..\Cozy.Source\Cozy.Security.NHW;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_RangeChecking>false</DCC_RangeChecking>
    <DCC_OverflowChecking>false</DCC_OverflowChecking>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_DebugInformation>false</DCC_DebugInformation>
    <DCC_IncludePath>..\Cozy.NHW.Fixtures;$(DCC_IncludePath)</DCC_IncludePath>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">Cozy.NHW.FileGuard.Tests.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win64">True</Platform>
        <Platform value="Win32">False</Platform>
      </Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>