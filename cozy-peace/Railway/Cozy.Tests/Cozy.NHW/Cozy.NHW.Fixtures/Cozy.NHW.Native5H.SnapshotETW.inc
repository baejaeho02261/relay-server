function TestSnapshotETWHardening(out Failure: string; out Checks: Integer): Boolean;
var
  M: TSnapshotETWReconciler;
  Threads: TThreadSampleMap;
  Events: TKernelEventList;
  D: TDetectionKinds;
  E: TKernelEvent;
  P: TReconcilePending;
  Cached: TReconcileEvent;
  Key: UInt64;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure AddThread(ID: Cardinal);
  var S: TThreadSample;
  begin S := Default(TThreadSample); S.ThreadID := ID; S.StartAddress := $1000; Threads.AddOrSetValue(ID, S); end;
  procedure AddEvent(ID: Cardinal; Kind: TKernelEventKind; Tick: UInt64; PID: Cardinal = 77);
  begin E := Default(TKernelEvent); E.PID := PID; E.ThreadID := ID; E.Kind := Kind; E.Tick := Tick; Events.Add(E); end;
  procedure Observe(Tick: UInt64; Independent: Boolean = True);
  begin D := []; M.Examine(77, Threads, True, True, False, False, Independent, Events, Tick, D); Events.Clear; end;
  procedure Prime;
  begin
    M.Reset; Threads.Clear; Events.Clear; D := []; AddThread(1); AddThread(2);
    M.Examine(77, Threads, True, True, False, True, False, Events, 10000, D);
  end;
begin
  Result := False; Failure := ''; Checks := 0; M := nil; Threads := nil; Events := nil;
  try
    try
      M := TSnapshotETWReconciler.Create; Threads := TThreadSampleMap.Create; Events := TKernelEventList.Create;
      Prime; Check(M.FPrimed and (M.FPrevious.Count = 2), 'baseline stores actual thread identities');
      Threads.Remove(2); AddThread(3); Observe(11000);
      Check(M.FPending.Count = 2, 'same thread count but ID replacement creates start and end differences');
      Observe(13500); Check(dkSnapshotETW in D, 'unmatched ID differences mature');
      Check(M.FPending.Count = 0, 'reported observations removed');
      Observe(15000); Check(not (dkSnapshotETW in D), 'unchanged snapshot no duplicate incident');
      Prime; AddThread(3); AddEvent(3, keThreadStart, 11000); Observe(11000);
      Check(M.FPending.Count = 0, 'matching ID and direction resolves start');
      Observe(14000); Check(not (dkSnapshotETW in D), 'matched event not warned');
      Prime; AddThread(3); AddEvent(999, keThreadStart, 11000); Observe(11000);
      Check(M.FPending.Count = 1, 'unrelated thread event cannot clear pending');
      Observe(13500); Check(dkSnapshotETW in D, 'unrelated activity does not suppress mismatch');
      Prime; AddThread(3); AddEvent(3, keThreadEnd, 11000); Observe(11000);
      Check(M.FPending.Count = 1, 'opposite event direction cannot explain start');
      Prime; AddThread(3); AddEvent(3, keThreadStart, 11000, 88); Observe(11000);
      Check(M.FPending.Count = 1, 'other target PID cannot explain change');
      Prime; AddThread(3); AddEvent(3, keThreadStart, 1000); Observe(11000);
      Check(M.FPending.Count = 1, 'old event outside candidate lookback not used');
      Prime; AddThread(3); AddEvent(3, keThreadStart, 12000); Observe(11000);
      Check(M.FPending.Count = 1, 'future timestamp not used');
      Prime; AddThread(3); AddEvent(3, keThreadStart, 0); Observe(11000);
      Check(M.FPending.Count = 1, 'unknown event timestamp not substituted with now');
      Prime; AddThread(3); Observe(11000); AddEvent(3, keThreadStart, 11500); Observe(12000);
      Check(M.FPending.Count = 0, 'late matching event clears only own pending change');
      Prime; AddEvent(3, keThreadStart, 10500); Observe(10500); AddThread(3); Observe(11000);
      Check(M.FPending.Count = 0, 'bounded cached event handles snapshot/callback delivery skew');
      Prime; AddThread(3); Observe(11000); D := [];
      M.Examine(77, Threads, False, True, False, False, True, Events, 12000, D);
      Check(not M.FPrimed and (M.FPending.Count = 0), 'invalid snapshot invalidates all pending state');
      Observe(14000); Check(not (dkSnapshotETW in D), 'recovery snapshot primes instead of using old counts');
      Prime; AddThread(3); Observe(11000);
      M.Examine(77, Threads, True, True, True, False, True, Events, 12000, D);
      Check(not M.FPrimed and (M.FPending.Count = 0), 'trace loss is unknown, not hostile');
      Prime; AddThread(3); Observe(11000);
      M.Examine(77, Threads, True, False, False, False, True, Events, 12000, D);
      Check(not M.FPrimed, 'unavailable trace cannot corroborate');
      Prime; AddThread(3); Observe(11000); M.Examine(77, nil, True, True, False, False, True, Events, 12000, D);
      Check(not M.FPrimed, 'nil snapshot tolerated');
      Prime; AddThread(3); Observe(11000); M.Examine(77, Threads, True, True, False, False, True, nil, 12000, D);
      Check(not M.FPrimed, 'nil event batch treated as incomplete');
      Prime; AddThread(3); Observe(11000); Observe(9000);
      Check(M.FPrimed and (M.FPending.Count = 0) and not (dkSnapshotETW in D), 'clock rollback re-primes without report');
      Prime; AddThread(3); Observe(11000); Observe(27000);
      Check((M.FPending.Count = 0) and not (dkSnapshotETW in D), 'long observation gap re-primes');
      Prime; AddThread(3); Observe(11000, False); Observe(13500, False);
      Check(not (dkSnapshotETW in D), 'independent signal remains required');
      Observe(14000, True); Check(dkSnapshotETW in D, 'mature difference plus corroboration reports');
      AddThread(4); Observe(15000); Observe(17500);
      Check(not (dkSnapshotETW in D), 'existing sixty-second report cooldown retained');
      Prime; Threads.Remove(2); AddEvent(2, keThreadEnd, 11000); Observe(11000);
      Check(M.FPending.Count = 0, 'matching end reconciles disappearance');
      Prime; AddThread(3); Observe(11000); Threads.Remove(3); Observe(12000);
      Check(not M.FPending.ContainsKey(ReconcileKey(3, keThreadStart)), 'reversal cancels old start candidate');
      Check(M.FPending.ContainsKey(ReconcileKey(3, keThreadEnd)), 'opposite change starts separately');
      Prime; AddThread(3); AddEvent(3, keThreadStart, 11000); Observe(11000);
      Key := ReconcileKey(3, keThreadStart); Cached := M.FEvents[Key];
      Check(Cached.Used, 'matched event marked consumed');
      Threads.Remove(3); AddEvent(3, keThreadEnd, 11500); Observe(11500);
      AddThread(3); AddEvent(3, keThreadStart, 11000); Observe(12000);
      Check(M.FPending.ContainsKey(Key), 'duplicate consumed start cannot explain later reuse');
      Prime; AddThread(3); AddThread(4); AddEvent(3, keThreadStart, 11000); Observe(11000);
      Check((M.FPending.Count = 1) and M.FPending.ContainsKey(ReconcileKey(4, keThreadStart)), 'one matched thread never clears another');
      Prime; AddThread(3); Observe(11000); M.Examine(88, Threads, True, True, False, False, True, Events, 12000, D);
      Check((M.FTargetPID = 88) and (M.FPending.Count = 0), 'new process target cannot inherit old mismatch');
      Prime; AddThread(3); Observe(11000); Observe(11000);
      P := M.FPending[ReconcileKey(3, keThreadStart)];
      Check((P.FirstSeen = 11000) and not (dkSnapshotETW in D), 'duplicate observation does not age pending');
      Check(ReconcileCandidate(True, True, True, 2500), 'existing pure helper positive contract');
      Check(not ReconcileCandidate(True, False, True, 5000), 'helper rejects unhealthy trace');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally Events.Free; Threads.Free; M.Free; end;
end;
