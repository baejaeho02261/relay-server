function TestAnomaly5J(out Failure: string; out Checks: Integer): Boolean;
var
  M: TAdaptiveAnomaly;
  Samples, Mean: Cardinal;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure Prime;
  var J: Integer;
  begin
    M.Reset; M.Observe(0, False, True, 0);
    for J := 1 to 10 do M.Observe(2, False, True, UInt64(J) * 1000);
  end;
begin
  Result := False; Failure := ''; Checks := 0;
  M := TAdaptiveAnomaly.Create;
  try
    try
      M.Observe(400, False, True, 1000);
      Check(not M.State.SampleValid and (M.State.ValidSamples = 0), 'first count lacks a duration');
      Check(not M.State.Anomalous and (M.State.LastCount = 400), 'raw first observation retained but not classified');
      M.Observe(2, False, True, 2000);
      Check(M.State.SampleValid and (M.State.RateX8 = 16), 'count normalized to per-second fixed point');
      Check((M.State.MeanX8 = 16) and (M.State.ValidSamples = 1), 'first complete interval trains');
      Prime; Check((M.State.ValidSamples = 10) and (M.State.MeanX8 = 16), 'stable two edges per second');
      M.Observe(20, False, True, 20000);
      Check(M.State.SampleValid and not M.State.Anomalous, 'longer scan with same rate not anomalous');
      Check((M.State.RateX8 = 16) and (M.State.MeanX8 = 16), 'same rate preserved across changed interval');
      Check(M.State.LastCount = 20, 'raw count remains raw');
      M.Observe(1, False, True, 20500);
      Check((M.State.RateX8 = 16) and not M.State.Anomalous, 'shorter equal-rate interval is consistent');
      Prime; Samples := M.State.ValidSamples; Mean := M.State.MeanX8;
      M.Observe(100, False, True, 11000);
      Check(M.State.Anomalous and M.State.SampleValid, 'high normalized rate detected after warmup');
      Check((M.State.ValidSamples = Samples) and (M.State.MeanX8 = Mean), 'anomaly excluded from learning');
      Check(M.State.AnomalyCount = 1, 'anomaly counter records detection');
      M.Observe(999, False, False, 12000);
      Check(not M.State.Anomalous and not M.State.SampleValid, 'invalid snapshot excluded');
      Check(M.State.ValidSamples = Samples, 'invalid frame does not advance warmup');
      M.Observe(999, False, True, 13000);
      Check(not M.State.SampleValid and not M.State.Anomalous, 'first recovery sample only reanchors');
      M.Observe(2, False, True, 14000);
      Check(M.State.SampleValid and not M.State.Anomalous, 'next complete interval resumes');
      Prime; Samples := M.State.ValidSamples;
      M.Observe(500, True, True, 11000); M.Observe(500, False, True, 12000);
      Check(M.State.ValidSamples = Samples, 'baseline transition breaks learning continuity');
      Prime; M.Observe(100, False, True, 10000);
      Check(not M.State.SampleValid, 'duplicate timestamp rejected');
      M.Observe(100, False, True, 11000);
      Check(not M.State.SampleValid, 'duplicate interval requires fresh anchor');
      Prime; M.Observe(100, False, True, 9000);
      Check(not M.State.SampleValid, 'backward timestamp rejected');
      Prime; M.Observe(500, False, True, 40001);
      Check(not M.State.SampleValid, 'overlong gap excluded from learning');
      M.Observe(500, False, True, 41001);
      Check(not M.State.SampleValid, 'recovery after long gap primes only');
      M.Reset; M.Observe(0, False, True, 0); M.Observe(1, False, True, 49);
      Check(not M.State.SampleValid, 'below minimum timing window rejected');
      M.Reset; M.Observe(0, False, True, 0); M.Observe(1, False, True, 50);
      Check(M.State.SampleValid and (M.State.RateX8 = 160), 'minimum timing boundary accepted');
      M.Reset; M.Observe(0, False, True, 0); M.Observe(60, False, True, 30000);
      Check(M.State.SampleValid and (M.State.RateX8 = 16), 'maximum timing boundary accepted');
      M.Reset; M.Observe(0, False, True, 0); M.Observe(High(Cardinal), False, True, 50);
      Check(M.State.RateX8 = High(Cardinal), 'rate narrowing saturates');
      Check(M.State.MeanX8 = ANOMALY_MAX_LEARNING_RATE_X8, 'learning input stays bounded');
      Prime; M.FState.ValidSamples := High(Cardinal);
      M.Observe(2, False, True, 11000);
      Check(M.State.ValidSamples = High(Cardinal), 'warmup counter saturates');
      M.FState.AnomalyCount := High(Cardinal); M.Observe(100, False, True, 12000);
      Check(M.State.Anomalous and (M.State.AnomalyCount = High(Cardinal)), 'anomaly count saturates');
      Prime; M.Observe(8, False, True, 12000);
      Check(M.State.MeanX8 = 20, 'elapsed duration controls averaging weight');
      M.Reset; M.Observe(0, False, True, High(UInt64) - 1000);
      M.Observe(2, False, True, High(UInt64));
      Check(M.State.SampleValid and (M.State.RateX8 = 16), 'near-maximum ticks subtract safely');
      Check(not NHWAnomalyCandidate(7, 16, 100), 'warmup prerequisite retained');
      Check(NHWAnomalyCandidate(8, 16, 14), 'threshold accepts rate boundary');
      Check(not NHWAnomalyCandidate(8, 16, 13), 'below rate threshold rejected');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally M.Free; end;
end;
