function TestFileGuard5K(out Failure: string; out Checks: Integer): Boolean;
var S: TFileGuardState; E, Base, Unknown: TFileEvidence;
    K: TDetectionKinds; I: Integer;
  procedure Check(C: Boolean; const Name: string);
  begin Inc(Checks); if not C then raise Exception.Create(Name); end;
  procedure Observe(const Value: TFileEvidence);
  begin K := []; S.Observe(Value, K); end;
  procedure Prime;
  var J: Integer;
  begin S.Reset; for J := 1 to 3 do Observe(Base); end;
begin
  Result := False; Failure := ''; Checks := 0;
  try
    Base := Default(TFileEvidence); Unknown := Default(TFileEvidence);
    Base.ReferenceIdKnown := True; Base.ReferenceId := 'I:original';
    Base.PathKnown := True; Base.PathPresent := True; Base.PathId := 'I:original';
    Base.ReferenceNameKnown := True; Base.ReferenceName := 'original.exe';
    S.Reset;
    for I := 1 to 5 do Observe(Unknown);
    Check(S.FPriming = 3, 'unknown probes do not consume baseline samples');
    E := Base; E.ReferenceId := ''; Observe(E);
    Check(S.FPriming = 3, 'empty reference is not a baseline');
    E := Base; E.PathId := ''; Observe(E);
    Check(S.FPriming = 3, 'missing ID on present path is not a baseline');
    for I := 1 to 3 do
    begin Observe(Base); Check(K = [], 'quiet valid startup sample'); end;
    Check(S.FPriming = 0, 'three valid core observations prime without optional metadata');
    E := Base; E.PathId := 'I:replaced'; Observe(E);
    Check(K = [dkFileSwap], 'existing file swap detection preserved');
    Observe(E); Check(K = [], 'same swap not repeated');
    Prime; E := Base; E.PathPresent := False; E.PathId := ''; Observe(E);
    Check((K = []) and (S.FMissingCount = 1), 'first path absence pending');
    Observe(Unknown);
    Check((S.FMissingCount = 0) and S.FPathPresent, 'unknown path breaks count not baseline');
    Observe(E); Check(K = [], 'absence after gap is first again');
    Observe(E); Check(K = [dkFileRename], 'two consecutive absences still detect');
    Observe(E); Check(K = [], 'continued absence not repeated');
    Prime; E := Base; E.PathPresent := False; Observe(E);
    E := Base; E.PathId := ''; Observe(E);
    Check(S.FMissingCount = 0, 'malformed present identity breaks absence count');
    E := Base; E.PathPresent := False; Observe(E);
    Check(K = [], 'malformed interval cannot bridge absence');
    S.BreakContinuity; Check(S.FMissingCount = 0, 'exception continuity hook resets absence');
    Check(S.FReferenceId = Base.ReferenceId, 'continuity hook preserves reference');
    Prime; E := Base; E.ReferenceName := 'renamed.exe'; Observe(E);
    Check(dkFileRename in K, 'reference name change detection retained');
    Prime; E := Base; E.ReparseKnown := True; E.ReparseHash := 1; Observe(E);
    E.ReparseHash := 2; Observe(E); Check(dkReparse in K, 'optional reparse detection retained');
    S.Reset; Observe(Base); Observe(Unknown); Observe(Base);
    Check(S.FPriming = 1, 'only valid observations count toward quiet baseline');
    Observe(Base); Check(S.FPriming = 0, 'baseline completes after third valid observation');
    K := [dkFileSwap]; S.Observe(Unknown, K);
    Check(K = [dkFileSwap], 'other sensor output not removed');
    Result := True;
  except on Ex: Exception do Failure := Ex.Message; end;
end;
