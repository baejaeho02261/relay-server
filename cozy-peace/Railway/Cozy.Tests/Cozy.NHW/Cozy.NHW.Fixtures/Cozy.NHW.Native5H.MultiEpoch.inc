var EpochTestMode: Integer;
function EpochTestEnum(Process: THandle; Modules: Pointer; BufferBytes: Cardinal;
  out Needed: Cardinal): BOOL; stdcall;
type PModulePair = ^TModulePair; TModulePair = array[0..1] of HMODULE;
begin
  Needed := 2 * SizeOf(HMODULE);
  Result := (Process <> 0) and (Modules <> nil) and (BufferBytes >= Needed);
  if EpochTestMode = 1 then begin Result := False; Exit; end;
  if EpochTestMode = 2 then raise Exception.Create('synthetic inventory exception');
  if EpochTestMode = 3 then begin Needed := BufferBytes + 8; Exit; end;
  if not Result then Exit;
  PModulePair(Modules)^[0] := HMODULE($2000);
  PModulePair(Modules)^[1] := HMODULE($1000);
  if EpochTestMode = 4 then PModulePair(Modules)^[1] := HMODULE($2000);
  if EpochTestMode = 5 then PModulePair(Modules)^[1] := 0;
end;
function TestMultiEpochHardening(out Failure: string; out Checks: Integer): Boolean;
var
  M: TMultiEpochBaseline; A, B, Bad, V: TModuleEpochView;
  Saved: TEnumModules; SavedTried, Raised: Boolean;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure Prime;
  begin M.Reset; M.FeedSample(A, 1000); M.FeedSample(A, 5000); end;
begin
  Result := False; Failure := ''; Checks := 0; M := nil;
  Saved := FnEnum; SavedTried := TriedEnum;
  try
    try
      FnEnum := EpochTestEnum; TriedEnum := True; EpochTestMode := 0;
      M := TMultiEpochBaseline.Create;
      A := Default(TModuleEpochView); A.Valid := True; A.Count := 1; A.Bases[0] := $1000;
      B := A; B.Count := 2; B.Bases[1] := $2000;
      Bad := Default(TModuleEpochView);
      Prime; Check(M.Stable and (M.Epoch = 1), 'accepted inventory stabilizes');
      M.FeedSample(B, 6000); Check(M.FPendingSamples = 1, 'new inventory pending');
      EpochTestMode := 1; M.Observe(True, False, 7000);
      Check(not M.Stable and (M.FPendingSamples = 0) and not M.FPending.Valid, 'native failure clears complete pending state');
      Check((M.Epoch = 1) and SameModuleEpoch(M.FAccepted, A), 'failure preserves accepted epoch');
      M.FeedSample(B, 8000); Check(M.Epoch = 1, 'first after gap not promoted');
      M.FeedSample(B, 8000); Check(M.FPendingSamples = 1, 'duplicate timestamp not confirmation');
      M.FeedSample(B, 9000); Check(M.Epoch = 2, 'two fresh observations promote');
      M.FeedSample(B, 12000); Check(M.Stable, 'new epoch stabilization delay');
      Prime; M.FeedSample(B, 6000); M.FeedSample(Bad, 7000);
      Check((M.FPendingSamples = 0) and not M.FPending.Valid, 'invalid injected sample clears pending');
      M.FeedSample(A, 8000); Check(not M.Stable, 'recovery restarts stability delay');
      M.FeedSample(A, 11000); Check(M.Stable, 'accepted baseline recovers after delay');
      Prime; M.FeedSample(B, 6000); M.FeedSample(B, 5000);
      Check((M.Epoch = 1) and (M.FPendingSamples = 1), 'rollback does not promote stale candidate');
      Prime; M.FeedSample(B, 6000); M.FeedSample(B, 37000);
      Check((M.Epoch = 1) and (M.FPendingSamples = 1), 'long gap restarts candidate without epoch reuse');
      Prime; M.FeedSample(B, 6000); EpochTestMode := 2; Raised := False;
      try M.Observe(True, False, 7000); except on E: Exception do Raised := True; end;
      Check(Raised and not M.Stable and (M.FPendingSamples = 0), 'exception invalidates before propagation');
      EpochTestMode := 0; Check(ReadModuleEpochView(V), 'valid native inventory collected');
      Check((V.Count = 2) and (V.Bases[0] = $1000) and (V.Bases[1] = $2000), 'inventory sorted deterministically');
      EpochTestMode := 3; Check(not ReadModuleEpochView(V) and not V.Valid and (V.Count = 0), 'oversize result not published');
      EpochTestMode := 4; Check(not ReadModuleEpochView(V) and (V.Count = 0), 'duplicate modules not published');
      EpochTestMode := 5; Check(not ReadModuleEpochView(V) and (V.Count = 0), 'zero module not published');
      Bad := A; Bad.Count := 0; Check(not SameModuleEpoch(Bad, Bad), 'zero count rejected without unsigned loop underflow');
      Bad := A; Bad.Count := NHW_MAX_EPOCH_MODULES + 1;
      Check(not SameModuleEpoch(Bad, Bad), 'oversize count rejected before array access');
      Bad := B; Bad.Bases[0] := $2000; Bad.Bases[1] := $1000;
      Check(not SameModuleEpoch(Bad, Bad), 'unsorted external samples rejected');
      Check(SameModuleEpoch(A, A) and not SameModuleEpoch(A, B), 'valid equality preserved');
      M.Observe(False, False, 8000); Check((M.Epoch = 0) and not M.Stable, 'foreign target clears baseline');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally FnEnum := Saved; TriedEnum := SavedTried; M.Free; end;
end;
