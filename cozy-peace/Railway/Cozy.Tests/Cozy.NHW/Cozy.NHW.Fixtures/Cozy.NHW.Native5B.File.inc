var
  TestFileMode, TestFileCalls: Integer;
function TestFileQuery(Handle: THandle; var Io: TNativeIoStatus;
  Buffer: Pointer; Bytes, InfoClass: Cardinal): LongInt; stdcall;
begin
  Inc(TestFileCalls);
  Io.Status := 0; Io.Information := Bytes;
  FillChar(Buffer^, Bytes, 0);
  PByte(Buffer)^ := 42;
  case TestFileMode of
    1: Io.Information := 0;
    2: Io.Information := NativeUInt(Bytes) + 1;
    3: Io.Information := Bytes - 1;
    4: begin Io.Status := -1; Exit(-1); end;
    5: if TestFileCalls = 1 then Exit(LongInt(STATUS_BUFFER_TOO_SMALL));
    6: Exit(LongInt(STATUS_BUFFER_TOO_SMALL));
    7: Io.Status := -1;
  end;
  Result := 0;
end;
function TestFileNativeHardening(out Failure: string; out Checks: Integer): Boolean;
var
  B, R: TBytes;
  Name: string;
  H, H2: UInt64;
  SavedQuery: TNtQueryFile;
  SavedResolved: Integer;
  procedure Check(V: Boolean; const S: string);
  begin Inc(Checks); if not V then raise Exception.Create(S); end;
  procedure Zero(N: Integer);
  begin SetLength(B, N); if N <> 0 then FillChar(B[0], N, 0); end;
  procedure U32(Offset: Integer; Value: Cardinal);
  begin Move(Value, B[Offset], SizeOf(Value)); end;
  procedure U16(Offset: Integer; Value: Word);
  begin Move(Value, B[Offset], SizeOf(Value)); end;
  procedure TextAt(Offset: Integer; const Text: string);
  begin if Text <> '' then Move(PWideChar(Text)^, B[Offset], Length(Text) * 2); end;
  procedure Mode(N: Integer);
  begin TestFileMode := N; TestFileCalls := 0; end;
begin
  Checks := 0; Failure := ''; Result := False;
  SavedQuery := NtQueryFilePtr; SavedResolved := FileResolved;
  try
    try
      NtQueryFilePtr := TestFileQuery; FileResolved := 1;
      Check(not ValidMetadataPath(''), 'empty path');
      Check(not ValidMetadataPath('a' + #0 + 'b'), 'embedded NUL path');
      Check(ValidMetadataPath('C:\test.exe'), 'normal path');
      Check(not ValidMetadataPath(StringOfChar('x', 32768)), 'path cap');
      Zero(24); Mode(0);
      Check(QueryFixed(1, CLASS_FILE_ID, @B[0], 24), 'fixed exact bytes');
      Mode(3); Check(not QueryFixed(1, CLASS_FILE_ID, @B[0], 24), 'fixed short rejected');
      Check(B[0] = 0, 'partial fixed output wiped');
      Mode(2); Check(not QueryFixed(1, CLASS_FILE_ID, @B[0], 24), 'fixed overreport rejected');
      Mode(7); Check(not QueryFixed(1, CLASS_FILE_ID, @B[0], 24), 'completion status checked');
      Check(not QueryFixed(0, CLASS_FILE_ID, @B[0], 24), 'zero handle');
      Check(not QueryFixed(1, CLASS_FILE_ID, nil, 24), 'nil output buffer');
      Mode(0); Check(QueryVariable(1, CLASS_FILE_NAME, 8192, R), 'variable success');
      Check(Length(R) = 4096, 'variable uses byte count');
      Mode(1); Check(not QueryVariable(1, CLASS_FILE_NAME, 8192, R), 'zero returned count rejected');
      Check(Length(R) = 0, 'no partial variable output');
      Mode(2); Check(not QueryVariable(1, CLASS_FILE_NAME, 8192, R), 'overreported variable bytes');
      Mode(5); Check(QueryVariable(1, CLASS_FILE_NAME, 6000, R), 'non-power-of-two cap retry');
      Check((Length(R) = 6000) and (TestFileCalls = 2), 'exact final capacity');
      Mode(6); Check(not QueryVariable(1, CLASS_FILE_NAME, 8192, R), 'retry exhaustion');
      Check((Length(R) = 0) and (TestFileCalls = 2), 'retry capped');
      Zero(8); U32(0, 4); TextAt(4, 'ab');
      Check(DecodeFileName(B, Name) and (Name = 'ab'), 'bounded filename');
      U32(0, 3); Check(not DecodeFileName(B, Name), 'odd UTF16 length');
      U32(0, 8); Check(not DecodeFileName(B, Name), 'filename exceeds response');
      U32(0, 4); U16(4, 0); Check(not DecodeFileName(B, Name), 'NUL filename');
      Zero(40); U32(4, 14); TextAt(24, '::$DATA');
      Check(DecodeStreamSet(B, H), 'default data stream');
      Check(H = FNV_OFFSET, 'default stream excluded from ADS digest');
      U32(0, 24); Check(not DecodeStreamSet(B, H), 'stream next header truncation');
      Check(H = 0, 'failed stream digest reset');
      U32(0, 0); U32(4, 15); Check(not DecodeStreamSet(B, H), 'odd stream name');
      U32(4, 14); B[15] := $80; Check(not DecodeStreamSet(B, H), 'negative stream size');
      Zero(30); U32(0, 30); U32(4, 1); U32(24, 1); TextAt(28, 'x');
      Check(DecodeLinkNames(B, H), 'single hard link');
      U32(4, 2); Check(not DecodeLinkNames(B, H), 'link count mismatch');
      U32(4, 1); U32(24, 2); Check(not DecodeLinkNames(B, H), 'hard link filename truncated');
      U32(24, 1); U32(8, 21); Check(not DecodeLinkNames(B, H), 'unaligned link offset');
      Zero(20); B[0] := 1; U16(2, $8004);
      Check(DecodeFileDacl(B, 20, H), 'present NULL DACL');
      U16(2, $8000); Check(DecodeFileDacl(B, 20, H2), 'absent DACL');
      Check(H <> H2, 'NULL and absent DACL distinct');
      U16(2, 4); Check(not DecodeFileDacl(B, 20, H), 'absolute descriptor rejected');
      Zero(28); B[0] := 1; U16(2, $8004); U32(16, 20); B[20] := 2; U16(22, 8);
      Check(DecodeFileDacl(B, 28, H), 'empty bounded ACL');
      U16(24, 1); Check(not DecodeFileDacl(B, 28, H), 'missing ACE rejected');
      Check(H = 0, 'failed DACL digest reset');
      U16(24, 0); U32(16, 4); Check(not DecodeFileDacl(B, 28, H), 'ACL overlaps descriptor');
      Zero(12); U16(4, 4); Check(ReparsePayloadValid(B, 12), 'bounded reparse');
      U16(4, 5); Check(not ReparsePayloadValid(B, 12), 'reparse payload overrun');
      Check(not ReparsePayloadValid(B, 13), 'reparse returned size overrun');
      Check(not ReparsePayloadValid(B, 7), 'reparse short header');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally
    NtQueryFilePtr := SavedQuery; FileResolved := SavedResolved;
  end;
end;
