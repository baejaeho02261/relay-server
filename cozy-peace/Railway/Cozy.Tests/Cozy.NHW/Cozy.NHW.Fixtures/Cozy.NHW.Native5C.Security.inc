function TestSecurityHardening(out Failure: string; out Checks: Integer): Boolean;
var
  B: TBytes; Sig, OtherSig, EmptySig, NullSig: UInt64;
  Identity, OtherIdentity: string;
  M: TSecurityMonitor; O: TList<TObservedTokenHandle>; Owners: TCreationTimeMap;
  Item: TObservedTokenHandle; Events: TDetectionKinds; Track: TTokenTrack;
  Pair: TPair<string, TTokenTrack>;
  PreviousToken, CurrentToken: TTokenSecuritySnapshot;
  SidPointer: NativeUInt; Level: Cardinal;
  procedure Check(V: Boolean; const Name: string);
  begin Inc(Checks); if not V then raise Exception.Create(Name); end;
  procedure PutWord(Offset: Integer; Value: Word);
  begin Move(Value, B[Offset], SizeOf(Value)); end;
  procedure PutCardinal(Offset: Integer; Value: Cardinal);
  begin Move(Value, B[Offset], SizeOf(Value)); end;
  procedure MakeEmpty;
  begin
    SetLength(B, 64); FillChar(B[0], Length(B), 0);
    B[0] := 1; PutWord(2, $8004); PutCardinal(16, 20);
    B[20] := 2; PutWord(22, 8); PutWord(24, 0);
  end;
  procedure MakeAce;
  begin
    MakeEmpty; PutWord(22, 28); PutWord(24, 1);
    // One bounded ACCESS_ALLOWED_ACE with a minimal one-subauthority SID.
    B[28] := 0; PutWord(30, 20); PutCardinal(32, 1);
    B[36] := 1; B[37] := 1; B[43] := 1; PutCardinal(44, 0);
  end;
begin
  Result := False; Failure := ''; Checks := 0;
  M := nil; O := nil; Owners := nil;
  try
    try
      MakeEmpty;
      Check(TryDaclBufferSignature(B, 28, Sig), 'empty DACL accepted'); EmptySig := Sig;
      PutCardinal(16, 0);
      Check(TryDaclBufferSignature(B, 20, Sig), 'NULL DACL accepted'); NullSig := Sig;
      Check(EmptySig <> NullSig, 'empty DACL distinct from NULL');
      PutWord(2, $8000);
      Check(TryDaclBufferSignature(B, 20, Sig), 'absent DACL accepted');
      Check((Sig <> EmptySig) and (Sig <> NullSig), 'absent distinct from present');
      MakeEmpty; B[0] := 2;
      Check(not TryDaclBufferSignature(B, 28, Sig) and (Sig = 0), 'descriptor revision');
      MakeEmpty; PutWord(2, 4);
      Check(not TryDaclBufferSignature(B, 28, Sig), 'absolute descriptor rejected');
      MakeEmpty;
      Check(not TryDaclBufferSignature(B, 19, Sig), 'short descriptor');
      Check(not TryDaclBufferSignature(B, 65, Sig), 'returned length beyond allocation');
      PutCardinal(16, 4);
      Check(not TryDaclBufferSignature(B, 28, Sig), 'ACL overlaps fixed header');
      PutCardinal(16, 21);
      Check(not TryDaclBufferSignature(B, 64, Sig), 'unaligned ACL');
      PutCardinal(16, High(Cardinal));
      Check(not TryDaclBufferSignature(B, 64, Sig), 'huge ACL offset');
      MakeEmpty; B[20] := 3;
      Check(not TryDaclBufferSignature(B, 28, Sig), 'unsupported ACL revision');
      MakeEmpty; B[20] := 4;
      Check(TryDaclBufferSignature(B, 28, Sig), 'DS ACL revision accepted');
      MakeEmpty; PutWord(22, 7);
      Check(not TryDaclBufferSignature(B, 28, Sig), 'short ACL');
      MakeEmpty; PutWord(22, 64);
      Check(not TryDaclBufferSignature(B, 64, Sig), 'ACL extent exceeds returned length');
      MakeEmpty; PutWord(24, 1);
      Check(not TryDaclBufferSignature(B, 28, Sig), 'ACE count exceeds framed entries');
      MakeAce;
      Check(TryDaclBufferSignature(B, 48, Sig), 'bounded ACE accepted');
      B[32] := 3;
      Check(TryDaclBufferSignature(B, 48, OtherSig), 'changed access mask valid');
      Check(Sig <> OtherSig, 'meaningful ACE change changes fingerprint');
      MakeAce; PutWord(30, 0);
      Check(not TryDaclBufferSignature(B, 48, Sig) and (Sig = 0), 'zero ACE size');
      MakeAce; PutWord(30, 3);
      Check(not TryDaclBufferSignature(B, 48, Sig), 'short ACE header');
      MakeAce; PutWord(30, 19);
      Check(not TryDaclBufferSignature(B, 48, Sig), 'unaligned ACE length');
      MakeAce; PutWord(30, 24);
      Check(not TryDaclBufferSignature(B, 48, Sig), 'ACE extends outside ACL');
      MakeAce; PutWord(24, 2);
      Check(not TryDaclBufferSignature(B, 48, Sig), 'extra ACE count');
      MakeAce; PutWord(22, 44);
      Check(TryDaclBufferSignature(B, 64, Sig), 'ACL with unused storage accepted');
      B[63] := 255; B[48] := 17;
      Check(TryDaclBufferSignature(B, 64, OtherSig) and (Sig = OtherSig), 'unused slack not a DACL change');
      MakeEmpty; B[21] := 1;
      Check(not TryDaclBufferSignature(B, 28, Sig), 'ACL reserved byte rejected');
      MakeEmpty; PutWord(26, 1);
      Check(not TryDaclBufferSignature(B, 28, Sig), 'ACL reserved word rejected');
      Check(not ThreadSecurityIdentity(10, 0, Identity) and (Identity = ''), 'unknown creation not cacheable');
      Check(not ThreadSecurityIdentity(0, 10, Identity), 'zero thread id');
      Check(ThreadSecurityIdentity(10, 20, Identity), 'known thread identity');
      Check(ThreadSecurityIdentity(10, 21, OtherIdentity), 'reused tid new lifetime');
      Check(Identity <> OtherIdentity, 'lifetime distinguishes reused TID');
      Check(not TryThreadCreationStamp(0, Sig) and (Sig = 0), 'zero thread creation query');
      Check(not SameProcessCreation(0, 0), 'unknown process identity');
      Check(not TryDaclSignature(0, Sig) and (Sig = 0), 'zero DACL handle');
      PreviousToken := Default(TTokenSecuritySnapshot);
      PreviousToken.ValidFields := TOKEN_FIELD_STATISTICS or TOKEN_FIELD_PRIVILEGES or
        TOKEN_FIELD_ELEVATION or TOKEN_FIELD_INTEGRITY or TOKEN_FIELD_RESTRICTED or
        TOKEN_FIELD_APPCONTAINER or TOKEN_FIELD_LINKED;
      PreviousToken.TokenId := 1; PreviousToken.AuthenticationId := 2;
      PreviousToken.TokenType := 1; PreviousToken.ElevationType := 1;
      PreviousToken.IntegrityLevel := $2000;
      PreviousToken.Restricted := 1; PreviousToken.AppContainer := 1;
      PreviousToken.PrivilegeCount := 2;
      PreviousToken.Privileges[0].Luid := 10;
      PreviousToken.Privileges[0].Attributes := 2;
      PreviousToken.Privileges[1].Luid := 20;
      PreviousToken.Privileges[1].Attributes := 0;
      CurrentToken := PreviousToken;
      Check(TokenSecurityDelta(PreviousToken, CurrentToken) = 0, 'stable token is not detection');
      CurrentToken.ModifiedId := 42;
      Check(TokenSecurityDelta(PreviousToken, CurrentToken) = 0, 'modified counter alone is not escalation');
      CurrentToken.Privileges[0].Attributes := 0;
      Check(TokenSecurityDelta(PreviousToken, CurrentToken) = 0, 'privilege reduction is not escalation');
      CurrentToken := PreviousToken; CurrentToken.Privileges[1].Attributes := 2;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_PRIVILEGE_ESCALATED) <> 0, 'enabled privilege escalates');
      CurrentToken := PreviousToken; CurrentToken.PrivilegeCount := 3; CurrentToken.Privileges[2].Luid := 30;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_PRIVILEGE_ESCALATED) <> 0, 'new privilege escalates');
      CurrentToken := PreviousToken; CurrentToken.PrivilegeCount := 1;
      Check(TokenSecurityDelta(PreviousToken, CurrentToken) = 0, 'removed privilege is not escalation');
      CurrentToken := PreviousToken; CurrentToken.TokenId := 3;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_REPLACED) <> 0, 'token replacement retained');
      CurrentToken := PreviousToken; CurrentToken.AuthenticationId := 3;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_AUTHENTICATION_CHANGED) <> 0, 'authentication contradiction');
      CurrentToken := PreviousToken; CurrentToken.TokenType := 2;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_TYPE_CHANGED) <> 0, 'primary token type change');
      CurrentToken := PreviousToken; CurrentToken.IntegrityLevel := $3000;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_INTEGRITY_RAISED) <> 0, 'integrity increase');
      CurrentToken.IntegrityLevel := $1000;
      Check(TokenSecurityDelta(PreviousToken, CurrentToken) = 0, 'integrity decrease');
      CurrentToken := PreviousToken; CurrentToken.Elevated := 1;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_PRIVILEGE_ESCALATED) <> 0, 'elevation increase');
      CurrentToken := PreviousToken; CurrentToken.Restricted := 0;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_RESTRICTION_REMOVED) <> 0, 'restriction removed');
      CurrentToken := PreviousToken; CurrentToken.AppContainer := 0;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_APPCONTAINER_REMOVED) <> 0, 'container escape');
      CurrentToken := PreviousToken; CurrentToken.LinkedTokenId := 7;
      Check((TokenSecurityDelta(PreviousToken, CurrentToken) and TOKEN_DELTA_LINKED_CHANGED) <> 0, 'linked token transition');
      CurrentToken := Default(TTokenSecuritySnapshot);
      Check(TokenSecurityDelta(PreviousToken, CurrentToken) = 0, 'unavailable fields never measured zero');
      MergeTokenSecuritySnapshot(PreviousToken, CurrentToken);
      Check(PreviousToken.TokenId = 1, 'unavailable sample retains baseline');
      CurrentToken.ValidFields := TOKEN_FIELD_STATISTICS; CurrentToken.TokenId := 99;
      CurrentToken.TokenType := 1; CurrentToken.AuthenticationId := 2;
      MergeTokenSecuritySnapshot(PreviousToken, CurrentToken);
      Check((PreviousToken.ValidFields = TOKEN_FIELD_STATISTICS) and
        (PreviousToken.PrivilegeCount = 0), 'new token does not inherit old optional baseline');
      SetLength(B, 56); FillChar(B[0], Length(B), 0); B[0] := 1; B[24] := 1;
      CurrentToken := Default(TTokenSecuritySnapshot);
      Check(TryTokenStatisticsBuffer(B, 56, CurrentToken), 'Win64 token statistics framing');
      Check(not TryTokenStatisticsBuffer(B, 55, CurrentToken), 'short token statistics rejected');
      Check((CurrentToken.ValidFields and TOKEN_FIELD_STATISTICS) = 0, 'failed statistics not marked valid');
      B[24] := 3;
      Check(not TryTokenStatisticsBuffer(B, 56, CurrentToken), 'invalid token type rejected');
      SetLength(B, 28); FillChar(B[0], Length(B), 0); PutCardinal(0, 2);
      PutCardinal(4, 20); PutCardinal(12, 2); PutCardinal(16, 10);
      Check(TryTokenPrivilegesBuffer(B, 28, CurrentToken), '12-byte privilege stride');
      Check((CurrentToken.Privileges[0].Luid = 10) and (CurrentToken.Privileges[1].Luid = 20), 'privilege order canonical');
      PutCardinal(16, 20);
      Check(not TryTokenPrivilegesBuffer(B, 28, CurrentToken), 'duplicate privilege rejected');
      PutCardinal(0, MAX_TOKEN_PRIVILEGES + 1);
      Check(not TryTokenPrivilegesBuffer(B, 28, CurrentToken), 'oversized privilege count rejected');
      PutCardinal(0, 2);
      Check(not TryTokenPrivilegesBuffer(B, 16, CurrentToken), 'truncated privilege array rejected');
      SetLength(B, 32); FillChar(B[0], Length(B), 0);
      SidPointer := NativeUInt(@B[16]); Move(SidPointer, B[0], SizeOf(SidPointer));
      B[16] := 1; B[17] := 1; B[23] := 16; PutCardinal(24, $2000);
      Check(TryTokenIntegrityBuffer(B, 28, Level) and (Level = $2000), 'bounded mandatory label');
      Check(not TryTokenIntegrityBuffer(B, 27, Level), 'truncated SID rejected');
      B[17] := 2;
      Check(not TryTokenIntegrityBuffer(B, 32, Level), 'non-integrity SID shape rejected');
      B[17] := 1;
      SidPointer := High(NativeUInt); Move(SidPointer, B[0], SizeOf(SidPointer));
      Check(not TryTokenIntegrityBuffer(B, 28, Level), 'outside allocation SID pointer rejected');
      SidPointer := NativeUInt(@B[0]); Move(SidPointer, B[0], SizeOf(SidPointer));
      Check(not TryTokenIntegrityBuffer(B, 28, Level), 'SID header overlap rejected');
      SidPointer := NativeUInt(@B[16]); Move(SidPointer, B[0], SizeOf(SidPointer)); B[23] := 5;
      Check(not TryTokenIntegrityBuffer(B, 28, Level), 'wrong SID authority rejected');
      M := TSecurityMonitor.Create; O := TList<TObservedTokenHandle>.Create;
      Owners := TCreationTimeMap.Create;
      Owners.Add(414141, 7654321);
      Item := Default(TObservedTokenHandle); Item.OwnerPID := 414141;
      Item.TokenObject := $123456; Item.GrantedAccess := TOKEN_QUERY_RIGHT;
      O.Add(Item); Events := [];
      M.ExamineTokenHandles(O, True, 9999, Owners, True, Events);
      Check(Events = [], 'baseline preserves silence');
      M.ExamineTokenHandles(O, True, 9999, Owners, False, Events);
      Check(Events = [], 'steady observation preserves silence');
      Item.GrantedAccess := TOKEN_QUERY_RIGHT or TOKEN_DUPLICATE_RIGHT; O[0] := Item;
      M.ExamineTokenHandles(O, True, 9999, Owners, False, Events);
      Check((dkTokenRights in Events) and not (dkTokenObject in Events), 'original rights detection retained');
      O.Clear; Events := [];
      M.ExamineTokenHandles(O, True, 9999, Owners, False, Events);
      M.ExamineTokenHandles(O, True, 9999, Owners, False, Events);
      Item.GrantedAccess := TOKEN_QUERY_RIGHT; O.Add(Item);
      M.ExamineTokenHandles(O, True, 9999, Owners, False, Events);
      Check(Events = [], 'query-only return is not token mutation');
      Item.TokenObject := $987654; Item.GrantedAccess := TOKEN_DUPLICATE_RIGHT; O[0] := Item;
      M.ExamineTokenHandles(O, True, 9999, Owners, True, Events);
      Check((dkTokenObject in Events) and (dkTokenRights in Events), 'bootstrap retains external modification evidence');
      Item.TokenObject := 0; O[0] := Item; Events := [];
      M.ExamineTokenHandles(O, True, 9999, Owners, False, Events);
      Check(Events = [], 'unknown object identity does not fabricate event');
      for Pair in M.FTokenTracks do
      begin Track := Pair.Value; Check(Track.Missing = 0, 'partial identity view not aged'); end;
      M.ExamineTokenHandles(nil, True, 9999, nil, False, Events);
      Check(Events = [], 'nil observation safe');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally Owners.Free; O.Free; M.Free; end;
end;
