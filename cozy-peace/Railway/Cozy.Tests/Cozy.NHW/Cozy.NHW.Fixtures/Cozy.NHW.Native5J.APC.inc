function TestAPC5J(out Failure: string; out Checks: Integer): Boolean;
var
  M: TAPCStyleEvidence;
  H: TTargetHolder;
  D: TDetectionKinds;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure Rights(Tick: UInt64; Baseline: Boolean = False);
  begin M.ObserveThreadRights(H, True, Baseline, Tick); end;
  procedure Impact(Tick: UInt64; Own: Boolean = True;
    ThreadOK: Boolean = True; Baseline: Boolean = False);
  begin D := [dkPECodeIntegrity]; M.Examine(Own, ThreadOK, Baseline, Tick, D); end;
begin
  Result := False; Failure := ''; Checks := 0;
  M := TAPCStyleEvidence.Create;
  try
    try
      H := Default(TTargetHolder); H.PID := 100; H.CreateTime := 500;
      H.IsThread := True; H.RightsUnion := THREAD_SET_CONTEXT_RIGHT;
      Rights(100); D := []; M.Examine(True, True, False, 200, D);
      Check(D = [], 'capability alone is not APC evidence');
      Impact(300); Check(dkAPCStyleEvidence in D, 'fresh independent impact correlates');
      Impact(400); Check(not (dkAPCStyleEvidence in D), 'cooldown preserved');
      M.Reset; Rights(100); Impact(200, True, False);
      Check(not M.FHaveContext, 'invalid snapshot clears context');
      Impact(300); Check(not (dkAPCStyleEvidence in D), 'recovery does not reuse pre-gap context');
      Rights(150); Impact(400);
      Check(not (dkAPCStyleEvidence in D), 'older queued rights cannot cross the gap');
      Rights(500); Impact(600);
      Check(dkAPCStyleEvidence in D, 'fresh post-gap rights restore correlation');
      Impact(700, True, False); Rights(800); Impact(900);
      Check(not (dkAPCStyleEvidence in D), 'gap does not reset report cooldown');
      Check(dkPECodeIntegrity in D, 'independent findings remain present');
      M.Reset; Rights(100); Impact(200, False);
      Check(not M.FHaveContext, 'foreign target breaks self-only context');
      Impact(300); Check(not (dkAPCStyleEvidence in D), 'return to own target requires new rights');
      M.Reset; Rights(100); Impact(200, True, True, True);
      Check(not M.FHaveContext, 'baseline examine clears prior evidence');
      Impact(300); Check(not (dkAPCStyleEvidence in D), 'baseline is not fresh evidence');
      M.Reset; Rights(100); Rights(200, True); Impact(300);
      Check(not (dkAPCStyleEvidence in D), 'baseline rights callback also clears prior context');
      M.Reset; Rights(100, True); Rights(100); Impact(100);
      Check(not (dkAPCStyleEvidence in D), 'same-tick baseline rights remain excluded');
      Rights(101); Impact(200);
      Check(dkAPCStyleEvidence in D, 'fresh post-baseline observation accepted');
      M.Reset; Rights(100); Impact(10101);
      Check(not M.FHaveContext, 'expired evidence is physically invalidated');
      Impact(10102); Check(not (dkAPCStyleEvidence in D), 'expired evidence not retained');
      M.Reset; Rights(100); Impact(10100);
      Check(dkAPCStyleEvidence in D, 'inclusive ten-second observation boundary');
      M.Reset; Rights(100); D := []; M.Examine(True, True, False, 500, D);
      Impact(400); Check(not M.FHaveContext, 'clock rollback breaks continuity');
      M.Reset; Rights(500); Impact(400);
      Check(not (dkAPCStyleEvidence in D), 'future context cannot correlate');
      M.Reset; Rights(0); Impact(0);
      Check(dkAPCStyleEvidence in D, 'tick zero not confused with no evidence');
      Impact(1); Check(not (dkAPCStyleEvidence in D), 'tick-zero report still throttles');
      M.Reset; H.CreateTime := 0; Rights(100); Impact(200);
      Check(not (dkAPCStyleEvidence in D), 'unknown actor creation rejected');
      H.CreateTime := 500; H.PID := 0; Rights(100); Impact(200);
      Check(not (dkAPCStyleEvidence in D), 'invalid actor PID rejected');
      M.Reset; H.PID := 100; H.IsThread := False; Rights(100); Impact(200);
      Check(not (dkAPCStyleEvidence in D), 'process rights are not thread context rights');
      M.Reset; H.IsThread := True; H.RightsUnion := THREAD_SUSPEND_RESUME_RIGHT;
      Rights(100); Impact(200);
      Check(not (dkAPCStyleEvidence in D), 'unrelated rights do not satisfy context prerequisite');
      H.RightsUnion := THREAD_SET_CONTEXT_RIGHT;
      M.Reset; M.ObserveThreadRights(H, False, False, 100); Impact(200);
      Check(not (dkAPCStyleEvidence in D), 'unchanged held rights do not create fresh evidence');
      Check(not NHWAPCIndependentImpact([dkThreadStart, dkThread]), 'thread start alone not impact');
      Check(NHWAPCIndependentImpact([dkWriteIntegrity]), 'memory impact family retained');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally M.Free; end;
end;
