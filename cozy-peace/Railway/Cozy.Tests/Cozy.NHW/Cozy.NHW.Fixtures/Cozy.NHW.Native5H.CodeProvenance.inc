var
  ProvenanceTestOK, ProvenanceTestRaise: Boolean;
  ProvenanceTestRegion: TVirtualRegion;
function ProvenanceTestQuery(Process: THandle; Address: NativeUInt;
  out Region: TVirtualRegion): Boolean;
begin
  if ProvenanceTestRaise then raise Exception.Create('synthetic query exception');
  Region := ProvenanceTestRegion;
  Result := ProvenanceTestOK and (Process <> 0) and (Address <> 0);
end;
function TestCodeProvenanceHardening(out Failure: string; out Checks: Integer): Boolean;
var
  M: TCodeProvenanceGraph;
  Threads: TThreadSampleMap;
  S: TThreadSample;
  D: TDetectionKinds;
  Saved: TProvenanceQueryHook;
  Raised: Boolean;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure Prime;
  begin
    M.Reset; Threads.Clear; D := [];
    ProvenanceTestOK := True; ProvenanceTestRaise := False;
    ProvenanceTestRegion := Default(TVirtualRegion);
    ProvenanceTestRegion.BaseAddress := $10000;
    ProvenanceTestRegion.AllocationBase := $10000;
    ProvenanceTestRegion.Size := $1000;
    ProvenanceTestRegion.State := ALLOC_MEM_COMMIT;
    ProvenanceTestRegion.Protect := ALLOC_PAGE_EXECUTE_READ;
    ProvenanceTestRegion.RegionType := ALLOC_MEM_PRIVATE;
    M.Examine(True, True, True, True, False, Threads, 1000, D);
    S := Default(TThreadSample); S.ThreadID := 11; S.StartAddress := $10040;
    Threads.Add(11, S);
  end;
  procedure Observe(Tick: UInt64; Independent: Boolean);
  begin D := []; M.Examine(True, True, False, True, Independent, Threads, Tick, D); end;
begin
  Result := False; Failure := ''; Checks := 0; M := nil; Threads := nil;
  Saved := ProvenanceQueryHook;
  try
    try
      ProvenanceQueryHook := ProvenanceTestQuery;
      M := TCodeProvenanceGraph.Create; Threads := TThreadSampleMap.Create;
      Prime; Observe(2000, False); Observe(3000, False);
      Check((M.FNodes[11].Confirmations = 2) and not (dkCodeProvenance in D), 'independent signal required');
      ProvenanceTestOK := False; Observe(4000, True);
      Check((M.FNodes[11].Confirmations = 0) and not (dkCodeProvenance in D), 'CURRENT failed read cannot use old confirmations');
      ProvenanceTestOK := True; Observe(5000, True);
      Check((M.FNodes[11].Confirmations = 1) and not (dkCodeProvenance in D), 'failure starts fresh confirmation');
      Observe(6000, True); Check(dkCodeProvenance in D, 'two fresh successful reads report');
      Observe(7000, True); Check(not (dkCodeProvenance in D), 'same candidate report suppressed');
      Observe(70000, True); Observe(71000, True);
      Check(M.FNodes[11].Reported and not (dkCodeProvenance in D), 'expiry does not re-report unchanged already-reported relationship');
      Prime; Observe(2000, True); Observe(2000, True);
      Check((M.FNodes[11].Confirmations = 1) and not (dkCodeProvenance in D), 'same-time duplicate not confirmation');
      Observe(3000, True); Check(dkCodeProvenance in D, 'later distinct observation confirms');
      Prime; Observe(2000, False); ProvenanceTestRegion.AllocationBase := $8000;
      Observe(3000, True);
      Check((M.FNodes[11].AllocationBase = $8000) and (M.FNodes[11].Confirmations = 1), 'remap replaces stored allocation');
      Observe(4000, True); Check(dkCodeProvenance in D, 'remapped region can confirm');
      Prime; Observe(2000, True); ProvenanceTestRegion.Protect := ALLOC_PAGE_EXECUTE_READWRITE;
      Observe(3000, True); Check(M.FNodes[11].Confirmations = 1, 'protection change restarts relationship');
      Prime; Observe(2000, True); ProvenanceTestRegion.RegionType := ALLOC_MEM_IMAGE;
      Observe(3000, True); Check((M.FNodes[11].Confirmations = 0) and not (dkCodeProvenance in D), 'image is not private evidence');
      Prime; Observe(2000, True); ProvenanceTestRegion.State := ALLOC_MEM_RESERVE;
      Observe(3000, True); Check(M.FNodes[11].Confirmations = 0, 'uncommitted region rejected');
      Prime; Observe(2000, True); ProvenanceTestRegion.Size := $20;
      Observe(3000, True); Check(M.FNodes[11].Confirmations = 0, 'non-containing region rejected');
      Prime; Observe(2000, True); ProvenanceTestRegion.AllocationBase := 0;
      Observe(3000, True); Check(M.FNodes[11].Confirmations = 0, 'zero allocation rejected');
      Prime; Observe(2000, True); D := [];
      M.Examine(True, False, False, True, True, Threads, 3000, D);
      Check((M.FNodes[11].Confirmations = 0) and not (dkCodeProvenance in D), 'invalid snapshot breaks all sequences');
      Observe(4000, True); Check(M.FNodes[11].Confirmations = 1, 'new read after snapshot gap only first');
      M.Examine(True, True, False, True, True, nil, 5000, D);
      Check(M.FNodes[11].Confirmations = 0, 'nil snapshot treated as unavailable');
      Prime; Observe(2000, True); M.Examine(True, True, False, False, True, Threads, 3000, D);
      Check(M.FNodes[11].Confirmations = 0, 'unstable epoch interrupts confirmation');
      Prime; Observe(2000, True); Observe(18001, True);
      Check((M.FNodes[11].Confirmations = 1) and not (dkCodeProvenance in D), 'expired candidate restarts');
      Prime; Observe(5000, True); Observe(4000, True);
      Check((M.FNodes[11].Confirmations = 1) and not (dkCodeProvenance in D), 'rollback cannot confirm');
      Prime; Observe(2000, True); M.Examine(True, True, True, True, True, Threads, 3000, D);
      Observe(4000, True); Observe(5000, True);
      Check(not M.FNodes[11].Eligible and not (dkCodeProvenance in D), 'baseline threads remain excluded');
      Prime; Observe(2000, True); ProvenanceTestRaise := True; Raised := False;
      try Observe(3000, True); except on E: Exception do Raised := True; end;
      Check(Raised and (M.FNodes[11].Confirmations = 0), 'exception invalidates before propagation');
      ProvenanceTestRaise := False; Threads.Clear; Observe(4000, True);
      Check(M.FNodes.Count = 0, 'departed thread removed');
      Prime; Observe(2000, True); M.Examine(False, True, False, True, True, Threads, 3000, D);
      Check((M.FNodes.Count = 0) and not M.FPrimed, 'foreign target resets self-only sensor');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally ProvenanceQueryHook := Saved; Threads.Free; M.Free; end;
end;
