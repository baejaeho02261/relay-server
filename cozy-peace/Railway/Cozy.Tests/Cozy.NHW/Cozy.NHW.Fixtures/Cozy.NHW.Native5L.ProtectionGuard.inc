function TestProtectionGuard5L(out Failure: string; out Checks: Integer): Boolean;
var M: TProtectionGuard; K: TDetectionKinds; R: TVirtualRegion;
    Track: TProtectionTrack; SweepNumber: UInt64;
  procedure Check(C: Boolean; const Msg: string);
  begin Inc(Checks); if not C then raise Exception.Create(Msg); end;
  procedure Sweep(Protect: Cardinal; Tick: UInt64);
  begin
    R.Protect := Protect; K := []; M.BeginSweep; M.ObserveRegion(R); M.EndSweep(Tick, K);
  end;
  procedure Prime;
  begin M.Reset; Sweep($04, 1000); Sweep($04, 2000); end;
begin
  Result := False; Failure := ''; Checks := 0; M := nil;
  try
    try
      M := TProtectionGuard.Create;
      R := Default(TVirtualRegion); R.BaseAddress := $140000;
      R.AllocationBase := $100000; R.Size := $1000;
      R.State := ALLOC_MEM_COMMIT; R.RegionType := ALLOC_MEM_PRIVATE;
      Prime; Check(K = [], 'startup baseline quiet');
      Sweep($20, 3000); Check(K = [], 'first transition pending');
      Check(M.FTracks[R.BaseAddress].Confirmations = 1, 'transition confirmation recorded');
      M.BeginSweep; M.ObserveRegion(R); M.CancelSweep;
      Check(M.FContinuityBroken and not M.FSweepOpen, 'cancel marks discontinuity');
      Check(M.FTracks[R.BaseAddress].Stable.Protect = $04, 'cancel preserves accepted baseline');
      Sweep($20, 4000); Check(K = [], 'first post-cancel mismatch is not old confirmation two');
      Check(M.FTracks[R.BaseAddress].Confirmations = 1, 'post-gap first count is one');
      Sweep($20, 5000); Check(dkProtectTransition in K, 'two new samples detect transition');
      Check(M.FTracks[R.BaseAddress].CycleStage = 1, 'RW-RX starts cycle');
      M.CancelSweep;
      Check(M.FRecentChanges.Count = 0, 'burst evidence cannot bridge cancelled sweep');
      Sweep($04, 6000); Sweep($04, 7000);
      Check(not (dkProtectionCycle in K), 'old cycle stage cannot bridge cancellation');
      Sweep($20, 8000); Sweep($20, 9000);
      Check(dkProtectTransition in K, 'new transition still detected');
      Sweep($04, 10000); Sweep($04, 11000);
      Check(dkProtectionCycle in K, 'uninterrupted new cycle still detected');
      Prime; Sweep($20, 3000); M.BeginSweep; M.ObserveRegion(R); M.BeginSweep;
      M.ObserveRegion(R); K := []; M.EndSweep(4000, K);
      Check(K = [], 'abandoned begin is a discontinuity');
      Check(M.FTracks[R.BaseAddress].Confirmations = 1, 'abandonment requires fresh confirmation');
      Sweep($20, 5000); Check(dkProtectTransition in K, 'recovery after abandoned sweep detects normally');
      Prime; Sweep($20, 3000); M.BeginSweep; M.ObserveRegion(R); M.FOverflow := True;
      K := [dkHeapState]; M.EndSweep(4000, K);
      Check(K = [dkHeapState], 'overflow adds no output and preserves other sensors');
      Check(M.FContinuityBroken, 'overflow routes through cancellation');
      Sweep($20, 5000); Check(K = [], 'overflow breaks pending confirmation');
      Sweep($20, 6000); Check(dkProtectTransition in K, 'two post-overflow samples detect');
      SweepNumber := M.FSweepNumber; K := []; M.EndSweep(7000, K);
      Check((K = []) and (M.FSweepNumber = SweepNumber), 'double end cannot repeat commit');
      Prime; Sweep($20, 3000); Sweep($20, 4000);
      Track := M.FTracks[R.BaseAddress]; Track.CycleStartTick := 3500;
      M.FTracks.AddOrSetValue(R.BaseAddress, Track); M.CancelSweep;
      Sweep($20, 5000);
      Check((M.FTracks[R.BaseAddress].CycleStage = 0) and
        (M.FTracks[R.BaseAddress].CycleStartTick = 0), 'equal-protection recovery also clears old cycle');
      M.Reset; Check((M.FTracks.Count = 0) and not M.FContinuityBroken, 'explicit reset remains full reset');
      R.RegionType := ALLOC_MEM_PRIVATE;
      Prime; Sweep($01, 3000); Sweep($01, 4000);
      Check(not (dkNoAccess in K), 'ordinary private PAGE_NOACCESS transition is not an attack');
      R.RegionType := ALLOC_MEM_IMAGE;
      Prime; Sweep($01, 3000); Sweep($01, 4000);
      Check(not (dkNoAccess in K), 'nonexecutable image transition is not a detection');
      Prime; Sweep($20, 3000); Sweep($20, 4000);
      Sweep($01, 5000); Sweep($01, 6000);
      Check(dkNoAccess in K, 'stable executable-image-to-noaccess signal remains visible');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally M.Free; end;
end;
