function TestETWImage5I(out Failure: string; out Checks: Integer): Boolean;
var
  M: TETWImageFusionMonitor;
  Events: TKernelEventList;
  D: TDetectionKinds;
  E: TKernelEvent;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure AddImage(PID: Cardinal; Tick: UInt64);
  begin E := Default(TKernelEvent); E.Kind := keImageLoad; E.PID := PID; E.Tick := Tick; Events.Add(E); end;
  procedure Prime;
  begin M.Reset; Events.Clear; D := []; end;
begin
  Result := False; Failure := ''; Checks := 0;
  M := TETWImageFusionMonitor.Create; Events := TKernelEventList.Create;
  try
    try
      Prime; AddImage(42, 1900); AddImage(42, 1000);
      M.Examine(Events, 42, False, False, False, 2000, D);
      Check(M.FLastLoadTick = 1900, 'reverse-order batch keeps newest image');
      Check(D = [], 'image alone does not detect');
      Events.Clear; AddImage(42, 1500);
      M.Examine(Events, 42, False, False, False, 2100, D);
      Check(M.FLastLoadTick = 1900, 'older later batch cannot rewind');
      D := [dkPrivateThread]; M.Examine(Events, 42, False, False, True, 2200, D);
      Check(dkETWImageFusion in D, 'independent recent evidence reports');
      Check(dkPrivateThread in D, 'existing detection retained');
      D := [dkPrivateThread]; M.Examine(Events, 42, False, False, True, 2300, D);
      Check(not (dkETWImageFusion in D), 'report cooldown retained');
      Events.Clear; D := []; M.Examine(Events, 42, False, True, False, 2400, D);
      Check((M.FLastLoadTick = 0) and (M.FLastExternalTick = 0) and
        (M.FLastThreadTick = 0), 'trace loss clears all correlation inputs');
      Check(M.FLastReport = 2200, 'loss does not erase cooldown');
      Prime; AddImage(42, 1000); D := [dkPrivateThread];
      M.Examine(Events, 42, False, False, False, 1000, D);
      Events.Clear; D := []; M.Examine(Events, 42, False, True, False, 1500, D);
      AddImage(42, 1000); AddImage(42, 1500); D := [dkPrivateThread];
      M.Examine(Events, 42, False, False, True, 2000, D);
      Check(not (dkETWImageFusion in D), 'replayed pre-loss and boundary events rejected');
      Check(M.FLastLoadTick = 0, 'loss floor prevents stale image resurrection');
      Events.Clear; AddImage(42, 2200); D := [dkPrivateThread];
      M.Examine(Events, 42, False, False, True, 2200, D);
      Check(dkETWImageFusion in D, 'fresh post-loss evidence can report');
      Prime; AddImage(99, 1000); AddImage(42, 3000); AddImage(42, 0);
      D := [dkPrivateThread]; M.Examine(Events, 42, False, False, True, 2000, D);
      Check(not (dkETWImageFusion in D), 'foreign/future/zero timestamps rejected');
      Check(M.FLastLoadTick = 0, 'invalid images not stored');
      Prime; AddImage(42, 1000); D := [dkPrivateThread];
      M.Examine(Events, 42, True, False, True, 1000, D);
      Check(not (dkETWImageFusion in D), 'baseline never reports');
      D := [dkPrivateThread]; M.Examine(Events, 42, False, False, True, 2000, D);
      Check(not (dkETWImageFusion in D), 'baseline images are not replayed into active epoch');
      Events.Clear; AddImage(42, 2500); D := [];
      M.Examine(Events, 42, False, False, False, 2500, D);
      D := [dkPrivateThread]; M.Examine(Events, 99, False, False, True, 3000, D);
      Check((M.FLastLoadTick = 0) and not (dkETWImageFusion in D), 'PID switch clears epoch');
      Prime; AddImage(42, 3000); D := [];
      M.Examine(Events, 42, False, False, False, 3000, D);
      M.Examine(nil, 42, False, False, True, 3500, D);
      Check((M.FLastLoadTick = 0) and M.FHaveEvidenceFloor, 'nil event list is coverage gap');
      Events.Clear; AddImage(42, 2000); D := [dkPrivateThread];
      M.Examine(Events, 42, False, False, True, 2500, D);
      Check((M.FLastLoadTick = 0) and not (dkETWImageFusion in D), 'clock rollback breaks sequence');
      M.Examine(Events, 0, False, False, True, 4000, D);
      Check(M.FTargetPID = 0, 'zero target resets');
      Prime; AddImage(42, 1000); D := []; M.Examine(Events, 42, False, False, False, 1000, D);
      Events.Clear; D := [dkPrivateThread]; M.Examine(Events, 42, False, False, True, 9001, D);
      Check(not (dkETWImageFusion in D), 'expired image cannot corroborate');
      Prime; Events.Clear; D := [dkProcess]; M.Examine(Events, 42, False, True, True, 1000, D);
      Check(D = [dkProcess], 'coverage gap does not erase other sensors output');
      Result := True;
    except on X: Exception do Failure := X.Message; end;
  finally Events.Free; M.Free; end;
end;
