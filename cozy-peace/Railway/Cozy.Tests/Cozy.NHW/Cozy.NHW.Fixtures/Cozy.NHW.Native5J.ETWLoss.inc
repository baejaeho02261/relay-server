function TestETWLoss5J(out Failure: string; out Checks: Integer): Boolean;
var
  M: TETWLossHealth;
  S, Before: TETWLossSnapshot;
  D: TDetectionKinds;
  Loss: Boolean;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure Feed(Tick: UInt64);
  begin Loss := False; M.AcceptSample(S, Tick, Loss); end;
  procedure Prime;
  begin
    M.Reset; M.SelectSource(1, 10, True);
    S := Default(TETWLossSnapshot); S.Available := True; S.EventsLost := 10;
    Feed(1000);
  end;
begin
  Result := False; Failure := ''; Checks := 0;
  M := TETWLossHealth.Create;
  try
    try
      Prime; Check(M.FPrimed and not Loss, 'first successful counter is baseline');
      S.Available := False; Feed(6000);
      Check(M.QueryGap and M.FPrimed, 'query failure retains same-source successful baseline');
      Check(M.FPrevious.EventsLost = 10, 'query failure does not replace counters with zero');
      Check(not Loss, 'query failure does not invent loss');
      M.SelectSource(1, 10, True);
      Check(M.QueryGap and M.FPrimed, 'unchanged observed source preserves the query gap');
      S.Available := True; S.EventsLost := 15; Feed(11000);
      Check(Loss, 'loss increase across temporary query failure detected');
      Check(not M.QueryGap, 'successful recovery ends query gap');
      Check(M.FPrevious.EventsLost = 15, 'successful recovered counter committed');
      Feed(16000); Check(not Loss, 'same cumulative total not counted again');
      S.EventsLost := 1; Feed(21000);
      Check(M.CounterDiscontinuity and not Loss, 'decrease marked unknown not fabricated loss');
      S.EventsLost := 2; Feed(26000);
      Check(Loss and not M.CounterDiscontinuity, 'next monotonic segment can be compared');
      Prime; S.LogBuffersLost := 1; Feed(6000);
      Check(Loss, 'log buffer increase retained');
      S.RealTimeBuffersLost := 1; Feed(11000);
      Check(Loss, 'realtime buffer increase retained');
      Before := S; S.EventsLost := 0; Inc(S.RealTimeBuffersLost);
      Check(not TraceCountersAdvanced(Before, S), 'mixed decrease/increase is not a trusted interval');
      Feed(16000); Check(M.CounterDiscontinuity and not Loss, 'mixed counter epoch rebased');
      Prime; S.Available := False; Feed(6000); Feed(11000);
      S.Available := True; S.EventsLost := 11; Feed(16000);
      Check(Loss, 'multiple failed queries do not erase last success');
      Prime; M.SelectSource(2, 10, True);
      Check(not M.FPrimed and not M.FHasQuery, 'different monitor rebases and queries immediately');
      S.EventsLost := 100; Feed(6000); Check(not Loss, 'different monitor counters not subtracted');
      Prime; M.SelectSource(1, 11, True);
      Check(not M.FPrimed, 'changed consumer identity rebases');
      S.EventsLost := 100; Feed(6000); Check(not Loss, 'new consumer primes only');
      Prime; M.SelectSource(1, 10, False);
      Check(not M.FPrimed and not M.FSourceReady, 'observed not-ready ends source continuity');
      M.SelectSource(1, 10, True); S.EventsLost := 100; Feed(6000);
      Check(not Loss, 'ready transition primes again');
      Prime; M.SelectSource(0, 0, True);
      Check(not M.FSourceReady and not M.FPrimed, 'zero owner cannot identify ready source');
      Before := Default(TETWLossSnapshot); S := Before;
      S.EventsLost := 100;
      Check(not TraceCountersAdvanced(Before, S), 'unavailable records are not valid deltas');
      Prime; S.EventsLost := High(Cardinal); Feed(6000);
      Check(Loss, 'maximum counter value compares without arithmetic overflow');
      S.EventsLost := 0; Feed(11000);
      Check(not Loss and M.CounterDiscontinuity, 'maximum-to-zero is unknown reset-or-wrap');
      M.Reset; D := [dkProcess]; M.Examine(nil, False, 0, D);
      Check(D = [dkProcess], 'optional unavailable ETW leaves findings alone');
      D := []; M.Examine(nil, True, 0, D);
      Check(dkETWLoss in D, 'explicit queue gap still warns at tick zero');
      D := []; M.Examine(nil, True, 1, D);
      Check(D = [], 'tick-zero warning is throttled');
      D := []; M.Examine(nil, True, 30000, D);
      Check(dkETWLoss in D, 'cooldown boundary permits warning');
      D := []; M.Examine(nil, True, 100, D);
      Check(dkETWLoss in D, 'clock rollback cannot suppress warnings forever');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally M.Free; end;
end;
