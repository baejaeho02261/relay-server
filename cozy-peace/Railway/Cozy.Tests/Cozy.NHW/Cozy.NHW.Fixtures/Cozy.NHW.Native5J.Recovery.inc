function TestRecovery5J(out Failure: string; out Checks: Integer): Boolean;
var
  M: TSensorCoverageRecovery;
  D: TDetectionKinds;
  procedure Check(Value: Boolean; const Name: string);
  begin Inc(Checks); if not Value then raise Exception.Create(Name); end;
  procedure Feed(Enabled: Boolean; Count: Cardinal; Tick: UInt64;
    Gap: Boolean = False; GapMS: UInt64 = 0; Interval: Cardinal = 1000);
  begin D := []; M.Observe(Enabled, Gap, Count, GapMS, Interval, Tick, D); end;
begin
  Result := False; Failure := ''; Checks := 0;
  M := TSensorCoverageRecovery.Create;
  try
    try
      Feed(False, 100, 0, True);
      Check((D = []) and (M.ReportedLoss = 0), 'disabled ETW does not consume stale totals');
      Check(M.LastCounterStatus = dcsUnavailable, 'unavailable distinguished from zero loss');
      Feed(True, 100, 100);
      Check((D = []) and (M.ReportedLoss = 0), 'first total establishes baseline only');
      Check(M.LastCounterStatus = dcsBaseline, 'baseline status explicit');
      Feed(True, 105, 200);
      Check((M.ReportedLoss = 5) and (dkObservationUncertain in D), 'monotonic observed delta accounted');
      Check(M.LastCounterStatus = dcsAdvanced, 'advance state explicit');
      Check(M.Degraded(201), 'new loss marks coverage degraded');
      Feed(True, 105, 300);
      Check((D = []) and (M.ReportedLoss = 5), 'unchanged total not double counted');
      Check(M.LastCounterStatus = dcsStable, 'stable state explicit');
      Feed(True, 3, 400);
      Check(M.ReportedLoss = 5, 'counter decrease does not fabricate one loss');
      Check(M.LastCounterStatus = dcsDecreaseUnknown, 'reset-or-wrap explicitly unknown');
      Feed(True, 4, 500);
      Check(M.ReportedLoss = 6, 'comparison resumes from new segment');
      Feed(False, 999, 600);
      Check(M.ReportedLoss = 6, 'disabled interval does not change total');
      Feed(True, 1000, 700);
      Check((M.ReportedLoss = 6) and (M.LastCounterStatus = dcsBaseline), 'reenabling rebases without false delta');
      Feed(True, 1002, 800); Check(M.ReportedLoss = 8, 'new enabled epoch delta accounted');
      M.Reset; Feed(True, 0, 0, True);
      Check(dkObservationUncertain in D, 'explicit loss at tick zero reported');
      Feed(True, 0, 1, True); Check(D = [], 'tick-zero cooldown enforced');
      Feed(True, 0, 30000, True); Check(dkObservationUncertain in D, 'cooldown boundary allows warning');
      M.Reset; Feed(False, 0, 100, False, 6000, 1000);
      Check(D = [], 'sampling threshold boundary not exceeded');
      Feed(False, 0, 200, False, 6001, 1000);
      Check(dkObservationUncertain in D, 'sampling gap independent of optional ETW');
      M.Reset; Feed(False, 0, 100, False, High(UInt64), 0);
      Check(D = [], 'zero interval does not create a threshold');
      Feed(False, 0, 200, False, High(UInt64), High(Cardinal));
      Check(dkObservationUncertain in D, 'wide interval multiplication stays safe');
      M.Reset; Feed(True, 10, 100);
      M.FReportedLoss := High(Cardinal) - 3; Feed(True, 20, 200);
      Check(M.ReportedLoss = High(Cardinal), 'sum saturates rather than wrapping');
      Feed(True, 21, 300);
      Check(M.ReportedLoss = High(Cardinal), 'saturated total remains saturated');
      M.Reset; Feed(True, High(Cardinal), 100); Feed(True, 0, 200);
      Check((M.ReportedLoss = 0) and (M.LastCounterStatus = dcsDecreaseUnknown), 'wrap-looking decrease not assigned a guessed delta');
      Check(dkObservationUncertain in D, 'unknown decrease is a coverage warning, not a count');
      Feed(True, 2, 300); Check(M.ReportedLoss = 2, 'post-decrease observed increment still counted');
      M.Reset; Feed(True, 0, 1000); Feed(True, 1, 2000);
      Feed(True, 999, 1500);
      Check(M.ReportedLoss = 1, 'clock rollback rebases cumulative comparison');
      Check(dkObservationUncertain in D, 'clock rollback warns about continuity');
      M.Reset; Feed(True, 0, High(UInt64) - 100, True);
      Check(M.FDegradedUntil = High(UInt64), 'degraded deadline saturates');
      Check(M.Degraded(High(UInt64)), 'saturated endpoint remains conservative');
      M.Reset; Feed(True, 0, 100, True);
      Check(M.Degraded(15099) and not M.Degraded(15100), 'ordinary degraded period expires');
      D := [dkProcess]; M.Observe(False, False, 0, 0, 1000, 15200, D);
      Check(D = [dkProcess], 'other detectors findings preserved');
      M.Reset; Check((M.ReportedLoss = 0) and not M.Degraded(0), 'reset clears lifetime metrics');
      Result := True;
    except on E: Exception do Failure := E.Message; end;
  finally M.Free; end;
end;
