function TestNamespaceNativeHardening(out Failure: string; out Checks: Integer): Boolean;
var
  Data: TBytes;
  Entries: TNamespaceEntries;
  Info: PNsDirectoryEntry;
  Sig, AbsentSig, NullSig: UInt64;
  C: Cardinal;
  W: Word;
  U: TNsUnicode;
  S: string;
  procedure Check(Value: Boolean; const Name: string);
  begin
    Inc(Checks);
    if not Value then raise Exception.Create(Name);
  end;
  procedure DirectoryPage;
  var NameText, TypeText: string;
  begin
    SetLength(Data, 128); FillChar(Data[0], Length(Data), 0);
    NameText := 'A'; TypeText := 'Event';
    Move(PWideChar(NameText)^, Data[64], 2);
    Move(PWideChar(TypeText)^, Data[68], 10);
    Info := PNsDirectoryEntry(@Data[0]);
    Info^.Name.Length := 2; Info^.Name.MaximumLength := 4;
    Info^.Name.Buffer := PWideChar(@Data[64]);
    Info^.TypeName.Length := 10; Info^.TypeName.MaximumLength := 12;
    Info^.TypeName.Buffer := PWideChar(@Data[68]);
  end;
  procedure Descriptor(Control: Word; Offset: Cardinal);
  begin
    SetLength(Data, 64); FillChar(Data[0], Length(Data), 0);
    Data[0] := 1;
    Move(Control, Data[2], SizeOf(Control));
    Move(Offset, Data[16], SizeOf(Offset));
  end;
begin
  Checks := 0; Failure := ''; Result := False;
  Entries := TNamespaceEntries.Create;
  try
    try
      Check(NamespaceLayoutsValid, 'Win64 NT layouts');
      Check(not NamespacePathValid(''), 'empty path');
      Check(not NamespacePathValid('relative'), 'relative path');
      Check(NamespacePathValid('\BaseNamedObjects'), 'native path');
      Check(not NamespacePathValid('\A' + #0 + 'B'), 'embedded NUL path');
      Check(not NamespacePathValid('\' + StringOfChar('A', 32760)), 'long path');
      DirectoryPage;
      Check(ParseNamespacePage(Data, 80, Entries) and (Entries.Count = 1), 'valid directory page');
      Check(Entries.ContainsKey('A'), 'normalized key');
      Check(not ParseNamespacePage(Data, 0, Entries) and (Entries.Count = 0), 'zero returned length');
      Check(not ParseNamespacePage(Data, 129, Entries), 'returned length exceeds buffer');
      Check(not ParseNamespacePage(Data, 64, Entries), 'strings outside returned bytes');
      Info^.Name.Length := 1;
      Check(not ParseNamespacePage(Data, 80, Entries), 'odd Unicode length');
      DirectoryPage; Info^.Name.MaximumLength := 0;
      Check(not ParseNamespacePage(Data, 80, Entries), 'length exceeds maximum');
      DirectoryPage; Info^.Name.Buffer := PWideChar(@Data[16]);
      Check(not ParseNamespacePage(Data, 80, Entries), 'header/string overlap');
      DirectoryPage; Info^.Name.Buffer := PWideChar(@Data[65]);
      Check(not ParseNamespacePage(Data, 80, Entries), 'unaligned Unicode');
      DirectoryPage; PNsDirectoryEntry(@Data[32])^.Name.Length := 2;
      Check(not ParseNamespacePage(Data, 80, Entries), 'malformed sentinel');
      DirectoryPage; Data[64] := Ord('\');
      Check(not ParseNamespacePage(Data, 80, Entries), 'nested child path rejected');
      DirectoryPage; Info^.Name.Length := 4;
      Check(not ParseNamespacePage(Data, 80, Entries), 'embedded NUL name rejected');
      SetLength(Data, 32); FillChar(Data[0], Length(Data), 0);
      Check(ParseNamespacePage(Data, 32, Entries) and (Entries.Count = 0), 'empty complete page');
      Check(not ParseNamespacePage(Data, 31, Entries), 'truncated sentinel');
      U := Default(TNsUnicode); U.Buffer := PWideChar(@Data[0]); U.MaximumLength := 32;
      Check(ReadBoundedUnicode(U, Data, 32, 65534, S) and (S = ''), 'empty counted string');
      U.Buffer := PWideChar(NativeUInt(@Data[0]) - NativeUInt(2));
      Check(not ReadBoundedUnicode(U, Data, 32, 65534, S), 'underflowing string pointer');
      Descriptor(SE_SELF_RELATIVE_NS, 0);
      Check(ParseNamespaceDacl(Data, 20, AbsentSig), 'absent DACL');
      Descriptor(SE_SELF_RELATIVE_NS or SE_DACL_PRESENT_NS, 0);
      Check(ParseNamespaceDacl(Data, 20, NullSig), 'null DACL');
      Check(AbsentSig <> NullSig, 'null and absent distinguished');
      Descriptor(SE_SELF_RELATIVE_NS or SE_DACL_PRESENT_NS, 20);
      Data[20] := 2; W := 8; Move(W, Data[22], 2);
      Check(ParseNamespaceDacl(Data, 28, Sig), 'empty valid ACL');
      Check((Sig <> NullSig) and (Sig <> AbsentSig), 'empty ACL distinguished');
      Check(not ParseNamespaceDacl(Data, 27, Sig) and (Sig = 0), 'partial ACL clears signature');
      Data[20] := 3;
      Check(not ParseNamespaceDacl(Data, 28, Sig), 'invalid ACL revision');
      Data[20] := 4;
      Check(ParseNamespaceDacl(Data, 28, Sig), 'DS ACL revision');
      W := 1; Move(W, Data[24], 2);
      Check(not ParseNamespaceDacl(Data, 28, Sig), 'ACE count exceeds bytes');
      W := 12; Move(W, Data[22], 2); W := 4; Move(W, Data[30], 2);
      Check(ParseNamespaceDacl(Data, 32, Sig), 'bounded ACE header traversal');
      W := 0; Move(W, Data[30], 2);
      Check(not ParseNamespaceDacl(Data, 32, Sig) and (Sig = 0), 'zero-sized ACE');
      W := 8; Move(W, Data[30], 2);
      Check(not ParseNamespaceDacl(Data, 32, Sig), 'ACE extends past ACL');
      C := 21; Move(C, Data[16], 4);
      Check(not ParseNamespaceDacl(Data, 32, Sig), 'unaligned DACL offset');
      Descriptor(SE_DACL_PRESENT_NS, 0);
      Check(not ParseNamespaceDacl(Data, 20, Sig), 'absolute descriptor not accepted');
      Descriptor(SE_SELF_RELATIVE_NS, 20);
      Check(not ParseNamespaceDacl(Data, 28, Sig), 'absent DACL with stale offset');
      Descriptor(SE_SELF_RELATIVE_NS, 0);
      Check(not ParseNamespaceDacl(Data, 65, Sig), 'descriptor used size too large');
      Check(NamespaceSizeStatus(LongInt(STATUS_BUFFER_TOO_SMALL_NS)), 'growth status');
      Check(not NamespaceSizeStatus(LongInt($C0000022)), 'access denied is not retryable size error');
      Result := True;
    except
      on E: Exception do Failure := E.Message;
    end;
  finally
    Entries.Free;
  end;
end;
