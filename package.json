{
  "name": "game-relay",
  "version": "7.0.1",
  "description": "GameConnect Windows64 encrypted TCP license service and administrator console",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-modules.js",
    "test": "node scripts/regression.js",
    "test:licenses": "node scripts/test-desktop-licenses.js",
    "test:migration": "node scripts/test-desktop-license-migration.js",
    "test:migration:sqlite": "node scripts/test-desktop-license-migration.js --sqlite",
    "test:retirement": "node scripts/test-desktop-retirement.js",
    "test:admin": "node scripts/test-desktop-admin-ui.js",
    "test:uicache": "node scripts/test-web-ui-cache.js",
    "check:ui": "node scripts/check-web-ui.js",
    "ui:manifest": "node scripts/check-web-ui.js --write",
    "test:http": "node scripts/test-desktop-http.js",
    "test:licenses:sqlite": "node scripts/test-desktop-licenses.js --sqlite",
    "test:connect": "node scripts/test-desktop-connect.js",
    "test:connect:sqlite": "node scripts/test-desktop-connect.js --sqlite",
    "check:native": "node scripts/check-connect-project.js",
    "test:bootstrap": "node scripts/test-desktop-bootstrap.js",
    "test:bootstrap:sqlite": "node scripts/test-desktop-bootstrap.js --sqlite",
    "test:machine": "node scripts/test-desktop-machine-policy.js",
    "test:machine:sqlite": "node scripts/test-desktop-machine-policy.js --sqlite"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "geoip-lite": "^1.4.10"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
