{
  "name": "game-relay",
  "version": "7.0.1",
  "description": "GameConnect Windows64 encrypted TCP license service and administrator console",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-modules.js",
    "test": "node scripts/regression.js",
    "test:licenses": "node scripts/test-desktop-licenses.js",
    "test:migration": "node scripts/test-desktop-license-migration.js",
    "test:migration:sqlite": "node scripts/test-desktop-license-migration.js --sqlite",
    "test:retirement": "node scripts/test-desktop-retirement.js",
    "test:admin": "node scripts/test-desktop-admin-ui.js",
    "test:uicache": "node scripts/test-web-ui-cache.js",
    "check:ui": "node scripts/check-web-ui.js",
    "ui:manifest": "node scripts/check-web-ui.js --write",
    "test:http": "node scripts/test-desktop-http.js",
    "test:licenses:sqlite": "node scripts/test-desktop-licenses.js --sqlite",
    "test:connect": "node scripts/test-desktop-connect.js",
    "test:connect:sqlite": "node scripts/test-desktop-connect.js --sqlite",
    "check:native": "node scripts/check-connect-project.js",
    "test:bootstrap": "node scripts/test-desktop-bootstrap.js",
    "test:bootstrap:sqlite": "node scripts/test-desktop-bootstrap.js --sqlite",
    "test:machine": "node scripts/test-desktop-machine-policy.js",
    "test:machine:sqlite": "node scripts/test-desktop-machine-policy.js --sqlite",
    "test:code": "node scripts/test-desktop-code-integrity.js",
    "test:reports": "node scripts/test-desktop-integrity-reports.js",
    "test:reports:sqlite": "node scripts/test-desktop-integrity-reports.js --sqlite",
    "check:code-contract": "node scripts/test-native-code-contract.js",
    "test:sqlite": "node scripts/test-sqlite-driver.js",
    "tls:rotate": "node tools/tls-rotate.js rotate",
    "tls:restore": "node tools/tls-rotate.js restore",
    "test:connect-tls": "node scripts/test-connect-tls.js",
    "deps:install": "npm ci --ignore-scripts",
    "deps:production": "npm ci --omit=dev --ignore-scripts",
    "test:extended-hashes": "node scripts/test-extended-hashes.js",
    "test:security-authority": "node scripts/test-security-authority.js",
    "test:security-tools": "node scripts/test-security-tools.js",
    "test:security-wire": "node scripts/test-security-wire.js",
    "test:security-operations": "node scripts/test-security-operations.js",
    "test:security-admin": "node scripts/test-security-admin.js",
    "test:security-evidence": "node scripts/test-security-evidence.js",
    "test:security-native-contract": "node scripts/test-security-native-contract.js",
    "test:release:tools": "node scripts/test-release-tools-split.js",
    "test:admin:modal": "node scripts/test-admin-modal-isolation.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "geoip-lite": "^1.4.10"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "hash-wasm": "4.12.0",
    "jsdom": "^30.0.1"
  }
}
